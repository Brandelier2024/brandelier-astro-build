---
// BtsExperience.astro
import { Image } from 'astro:assets';
---
<div id="brandelier-bts-env" class="relative bg-[#f4f7ff] text-[#00003E] w-full min-h-screen overflow-clip">
    <!-- Atmospheric Backgrounds (Light Theme) -->
    <canvas id="studio-dust-canvas" class="fixed top-0 left-0 w-screen h-screen pointer-events-none z-0 opacity-60"></canvas>
    <div class="relative z-20">
        <!-- Hero Section -->
        <section class="hero-section relative min-h-screen flex items-center justify-center pt-20 pb-10 px-6">
            <!-- Floating Images -->
            <div class="floating-img absolute w-40 md:w-64 h-56 md:h-80 top-[15%] left-[5%] md:left-[10%] rotate-[-8deg] rounded-xl overflow-hidden shadow-2xl z-10" data-speed="0.1" data-parallax="1.5">
                <Image src="https://brandelier.in/wp-content/uploads/2026/08/Brandelier-.jpg-scaled.jpeg" width={600} height={800} class="w-full h-full object-cover grayscale-[40%] hover:grayscale-0 transition-all duration-500 scale-110" alt="Camera Setup" />
            </div>
            <!-- Add the other floating images here following the same light-theme shadow logic -->

            <div class="hero-content text-center max-w-4xl mx-auto pointer-events-none z-30">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#3F9AE6]/15 border border-[#3F9AE6]/40 backdrop-blur-md mb-8 fade-in-up">
                    <span class="w-2 h-2 rounded-full bg-[#DD2EB8] shadow-[0_0_8px_#DD2EB8] animate-pulse"></span>
                    <span class="text-xs font-bold tracking-[0.2em] uppercase text-[#9B2FCA]">Behind Brandelier</span>
                </div>

                <h1 class="text-6xl md:text-8xl lg:text-9xl font-black tracking-tighter leading-[1] mb-6 gsap-reveal-text" style="clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);">
                    <span class="line block translate-y-[110%] opacity-0">The Making</span>
                    <span class="line block translate-y-[110%] opacity-0 text-transparent bg-clip-text bg-gradient-to-r from-[#9B2FCA] to-[#DD2EB8]">Of Magic.</span>
                </h1>

                <p class="text-lg md:text-2xl text-[#53647d] max-w-2xl mx-auto mb-16 leading-relaxed fade-in-up font-light">
                    Unfiltered moments from our sets. This is where strategy meets storytelling, lights are perfected, and the vision comes to life.
                </p>
            </div>
        </section>

        <!-- Cinematic Stacking Cards Section -->
        <section class="stack-section relative w-full pb-[10vh]">
            <!-- Card 01 -->
            <div class="stack-card sticky top-0 h-screen w-full flex items-center justify-center p-8">
                <div class="card-inner relative w-full max-w-[1200px] h-[80vh] rounded-[24px] overflow-hidden shadow-2xl border border-[#3F9AE6]/30 bg-[#f4f7ff]">
                    <div class="absolute inset-[-10%] w-[120%] h-[120%] z-0">
                        <Image class="gsap-parallax-img w-full h-full object-cover" src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" width={1600} height={1000} alt="Pre-Production" />
                    </div>
                    <div class="relative z-10 h-full flex flex-col justify-end p-8 md:p-16 bg-gradient-to-t from-white via-white/80 to-transparent">
                        <div class="overflow-hidden mb-2">
                            <span class="block text-[#9B2FCA] font-bold tracking-[0.2em] uppercase text-sm translate-y-full reveal-on-scroll">Phase 01</span>
                        </div>
                        <div class="overflow-hidden mb-4">
                            <h2 class="text-5xl md:text-7xl font-black text-[#00003E] translate-y-full reveal-on-scroll">The Blueprint.</h2>
                        </div>
                        <div class="overflow-hidden max-w-xl">
                            <p class="text-[#53647d] text-lg md:text-xl translate-y-full reveal-on-scroll">Where chaos becomes strategy. Storyboarding, location scouting, and mapping out visual transitions before we ever touch a camera.</p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Duplicate for Phase 02 and Phase 03 -->
        </section>
    </div>
</div>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    
    // Astro wraps this script so it runs client-side automatically
    gsap.registerPlugin(ScrollTrigger);

    // 1. Text Reveal
    gsap.to(".gsap-reveal-text .line", { y: 0, opacity: 1, duration: 1.2, stagger: 0.15, ease: "power4.out" });
    gsap.fromTo(".fade-in-up", { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 1, stagger: 0.1, ease: "power4.out", delay: 0.5 });

    // 2. Parallax Floating Images
    const floaters = gsap.utils.toArray('.floating-img') as HTMLElement[];
    floaters.forEach(img => {
        const speed = parseFloat(img.dataset.speed || '0.1') || 0.1;
        gsap.to(img, {
            y: () => -window.innerHeight * speed * 3,
            ease: "none",
            scrollTrigger: { trigger: ".hero-section", start: "top top", end: "bottom top", scrub: true }
        });
        // Idle float animation
        gsap.to(img, { y: "-=15", rotation: "+=2", duration: 3 + Math.random() * 2, yoyo: true, repeat: -1, ease: "sine.inOut" });
    });

    // 3. Stacking Cards
    const cards = gsap.utils.toArray('.stack-card') as HTMLElement[];
    cards.forEach((card, index) => {
        const inner = card.querySelector('.card-inner') as HTMLElement;
        const img = card.querySelector('.gsap-parallax-img') as HTMLElement;
        const textElements = card.querySelectorAll('.reveal-on-scroll');

        if (index < cards.length - 1) {
            gsap.to(inner, {
                scale: 0.9, opacity: 0.5,
                scrollTrigger: { trigger: card, start: "top top", end: "bottom top", scrub: true }
            });
        }

        gsap.fromTo(img, { y: "-15%" }, {
            y: "15%", ease: "none",
            scrollTrigger: { trigger: card, start: "top bottom", end: "bottom top", scrub: true }
        });

        gsap.to(textElements, {
            y: 0, duration: 0.8, stagger: 0.1, ease: "power3.out",
            scrollTrigger: { trigger: card, start: "top 60%", toggleActions: "play reverse play reverse" }
        });
    });

    // 4. Light Theme Canvas Particles (Optimized with IntersectionObserver & Reduced Motion)
    const btsEnv = document.getElementById('brandelier-bts-env');
    const canvas = document.getElementById('studio-dust-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (canvas && ctx && btsEnv && !prefersReducedMotion) {
        const particles: { x: number; y: number; size: number; speedY: number }[] = [];
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        
        for (let i = 0; i < 35; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                size: Math.random() * 1.5 + 0.1,
                speedY: Math.random() * -0.3 - 0.1
            });
        }

        let isAnimating = false;
        let animationFrameId: number | null = null;

        function draw() {
            if (!isAnimating || !ctx || !canvas) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = 'rgba(221, 46, 184, 0.4)';
            particles.forEach(p => {
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                p.y += p.speedY;
                if (p.y < 0) {
                    p.y = canvas.height;
                    p.x = Math.random() * canvas.width;
                }
            });
            animationFrameId = requestAnimationFrame(draw);
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    if (!isAnimating) {
                        isAnimating = true;
                        draw();
                    }
                } else {
                    isAnimating = false;
                    if (animationFrameId) {
                        cancelAnimationFrame(animationFrameId);
                        animationFrameId = null;
                    }
                }
            });
        }, { rootMargin: '100px 0px' });

        observer.observe(btsEnv);
    }
</script>