---
// ScrollAnimations.astro — Global GSAP ScrollTrigger animations applied site-wide
// This component detects common section patterns and animates them on scroll.
---

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ================================================================
  // GLOBAL SCROLL ANIMATION SYSTEM
  // Automatically detects and animates common page patterns.
  // ================================================================

  // ---- 1. PAGE HERO — Animate breadcrumb, h1, description ----
  const pageHero = document.querySelector('.page-hero') as HTMLElement;
  if (pageHero) {
    const breadcrumb = pageHero.querySelector('.breadcrumb');
    const h1 = pageHero.querySelector('h1');
    const desc = pageHero.querySelector('.hero-desc');
    const decoration = pageHero.querySelector('.hero-decoration');

    const heroTl = gsap.timeline({ defaults: { ease: "power4.out" } });

    if (breadcrumb) {
      heroTl.fromTo(breadcrumb,
        { opacity: 0, y: -15 },
        { opacity: 1, y: 0, duration: 0.6 },
        0.1
      );
    }
    if (h1) {
      heroTl.fromTo(h1,
        { opacity: 0, y: 50, clipPath: "inset(0 0 100% 0)" },
        { 
          opacity: 1, 
          y: 0, 
          clipPath: "inset(0 0 -30% 0)", 
          duration: 1,
          clearProps: "clipPath"
        },
        0.2
      );
    }
    if (desc) {
      heroTl.fromTo(desc,
        { opacity: 0, y: 25 },
        { opacity: 1, y: 0, duration: 0.8 },
        0.5
      );
    }
    if (decoration) {
      heroTl.fromTo(decoration,
        { scaleX: 0, transformOrigin: "left center" },
        { scaleX: 1, duration: 1.2, ease: "power2.out" },
        0.6
      );
    }
  }

  // ---- 2. SECTION HEADINGS — Reveal .section-label + h2 pairs ----
  function revealSectionHeading(section: Element) {
    const label = section.querySelector('.section-label, .sp-label');
    const h2 = section.querySelector('h2');

    if (!label && !h2) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 82%",
        once: true
      }
    });

    if (label) {
      tl.fromTo(label,
        { opacity: 0, x: -20 },
        { opacity: 1, x: 0, duration: 0.6, ease: "power3.out" }
      );
    }
    if (h2) {
      tl.fromTo(h2,
        { opacity: 0, y: 35, clipPath: "inset(0 0 100% 0)" },
        { 
          opacity: 1, 
          y: 0, 
          clipPath: "inset(0 0 -30% 0)", 
          duration: 0.9, 
          ease: "power4.out",
          clearProps: "clipPath"
        },
        label ? "-=0.3" : 0
      );
    }
  }

  // Find all sections and apply heading reveals
  document.querySelectorAll('section').forEach(section => {
    // Skip if section is inside #brandelier-bts-env (has its own animations)
    if (section.closest('#brandelier-bts-env')) return;
    revealSectionHeading(section);
  });

  // ---- 3. CARD GRIDS — Staggered reveal for card patterns ----
  const cardSelectors = [
    '.value-card', '.team-card', '.perk-card',
    '.feature-card', '.portfolio-card', '.article-card',
    '.home-blog-card', '.service-card',
    '.other-card', '.info-card'
  ];

  cardSelectors.forEach(selector => {
    const cards = gsap.utils.toArray(selector) as HTMLElement[];
    if (!cards.length) return;

    // Group cards by parent to animate grids together
    const parents = new Map<Element, HTMLElement[]>();
    cards.forEach(card => {
      const parent = card.parentElement;
      if (!parent) return;
      if (!parents.has(parent)) parents.set(parent, []);
      parents.get(parent)!.push(card);
    });

    parents.forEach((groupCards, parent) => {
      gsap.fromTo(groupCards,
        { opacity: 0, y: 45, scale: 0.96 },
        {
          opacity: 1, y: 0, scale: 1,
          duration: 0.65, stagger: 0.1, ease: "back.out(1.3)",
          scrollTrigger: {
            trigger: parent,
            start: "top 82%",
            toggleActions: "play none none reverse"
          }
        }
      );
    });
  });

  // ---- 4. STAT ITEMS — Scale-up with counter feel ----
  const statSelectors = ['.stat-item', '.about-stat'];
  statSelectors.forEach(selector => {
    const items = gsap.utils.toArray(selector) as HTMLElement[];
    if (!items.length) return;

    gsap.fromTo(items,
      { opacity: 0, y: 50, scale: 0.88 },
      {
        opacity: 1, y: 0, scale: 1,
        duration: 0.7, stagger: 0.12, ease: "back.out(1.5)",
        scrollTrigger: {
          trigger: items[0].closest('section') || items[0].parentElement,
          start: "top 75%",
          toggleActions: "play none none reverse"
        }
      }
    );
  });

  // ---- 5. SERVICE ROWS — Alternating slide-in ----
  const serviceRows = gsap.utils.toArray('.service-row') as HTMLElement[];
  serviceRows.forEach((row, i) => {
    gsap.fromTo(row,
      { opacity: 0, x: i % 2 === 0 ? -40 : 40, y: 15 },
      {
        opacity: 1, x: 0, y: 0,
        duration: 0.7, ease: "power3.out",
        scrollTrigger: {
          trigger: row,
          start: "top 85%",
          toggleActions: "play none none reverse"
        }
      }
    );
  });

  // ---- 6. LIST / TIMELINE ITEMS — Sequential reveal ----
  const listSelectors = [
    '.job-card', '.benefit-item', '.process-item',
    '.approach-grid article', '.process-step'
  ];

  listSelectors.forEach(selector => {
    const items = gsap.utils.toArray(selector) as HTMLElement[];
    if (!items.length) return;

    items.forEach((item, i) => {
      gsap.fromTo(item,
        { opacity: 0, y: 35, x: -15 },
        {
          opacity: 1, y: 0, x: 0,
          duration: 0.65, ease: "power3.out",
          scrollTrigger: {
            trigger: item,
            start: "top 88%",
            toggleActions: "play none none reverse"
          }
        }
      );
    });
  });

  // ---- 7. TWO-COLUMN GRIDS — Slide in from sides ----
  const gridSelectors = [
    '.story-grid', '.culture-grid', '.case-grid',
    '.statement-grid', '.careers-teaser-grid', '.contact-grid'
  ];

  gridSelectors.forEach(selector => {
    const grid = document.querySelector(selector) as HTMLElement;
    if (!grid) return;

    const children = Array.from(grid.children) as HTMLElement[];
    if (children.length < 2) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: grid,
        start: "top 75%",
        toggleActions: "play none none reverse"
      }
    });

    tl.fromTo(children[0],
      { opacity: 0, x: -50 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power3.out" }
    );
    tl.fromTo(children[1],
      { opacity: 0, x: 50 },
      { opacity: 1, x: 0, duration: 0.8, ease: "power3.out" },
      "-=0.5"
    );
  });

  // ---- 8. FULL-WIDTH IMAGES — Scale parallax ----
  const imageBreaks = document.querySelectorAll('.about-image-break, .proof-image');
  imageBreaks.forEach(section => {
    const img = section.querySelector('img') as HTMLElement;
    if (!img) return;

    gsap.fromTo(img,
      { scale: 1.12 },
      {
        scale: 1, ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top bottom",
          end: "bottom top",
          scrub: true
        }
      }
    );

    // Overlay text reveal
    const overlayText = section.querySelector('.image-overlay-text');
    if (overlayText) {
      gsap.fromTo(overlayText,
        { opacity: 0, y: 30 },
        {
          opacity: 1, y: 0, duration: 0.8, ease: "power3.out",
          scrollTrigger: {
            trigger: section,
            start: "top 50%",
            toggleActions: "play none none reverse"
          }
        }
      );
    }
  });

  // ---- 9. FEATURED POST — Special entrance ----
  const featuredPost = document.querySelector('.featured-post') as HTMLElement;
  if (featuredPost) {
    gsap.fromTo(featuredPost,
      { opacity: 0, y: 50, scale: 0.97 },
      {
        opacity: 1, y: 0, scale: 1,
        duration: 0.9, ease: "power3.out",
        scrollTrigger: {
          trigger: featuredPost,
          start: "top 80%",
          toggleActions: "play none none reverse"
        }
      }
    );
  }

  // ---- 10. CTA SECTIONS — Grand entrance ----
  const ctaSelectors = [
    '.about-cta', '.sp-cta', '.services-cta',
    '.speculative-cta', '.portfolio-cta', '.contact-section'
  ];

  ctaSelectors.forEach(selector => {
    const cta = document.querySelector(selector) as HTMLElement;
    if (!cta) return;

    const h2 = cta.querySelector('h2');
    const btn = cta.querySelector('a, button');
    const copy = cta.querySelector('.cta-copy, .large-copy');

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: cta,
        start: "top 72%",
        toggleActions: "play none none reverse"
      }
    });

    if (h2) {
      tl.fromTo(h2,
        { opacity: 0, y: 50 },
        { opacity: 1, y: 0, duration: 0.9, ease: "power4.out" }
      );
    }
    if (copy) {
      tl.fromTo(copy,
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" },
        "-=0.4"
      );
    }
    if (btn) {
      tl.fromTo(btn,
        { opacity: 0, y: 15 },
        { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" },
        "-=0.2"
      );
    }
  });

  // ---- 11. NEWSLETTER / FORM — Slide up ----
  const newsletter = document.querySelector('.newsletter-card, .contact-form-wrap') as HTMLElement;
  if (newsletter) {
    gsap.fromTo(newsletter,
      { opacity: 0, y: 40 },
      {
        opacity: 1, y: 0, duration: 0.8, ease: "power3.out",
        scrollTrigger: {
          trigger: newsletter,
          start: "top 78%",
          toggleActions: "play none none reverse"
        }
      }
    );
  }

  // ---- 12. FILTER BAR — Subtle entrance ----
  const filterBar = document.querySelector('.filter-bar') as HTMLElement;
  if (filterBar) {
    gsap.fromTo(filterBar,
      { opacity: 0, y: 20 },
      {
        opacity: 1, y: 0, duration: 0.6, ease: "power3.out",
        scrollTrigger: {
          trigger: filterBar,
          start: "top 88%",
          toggleActions: "play none none reverse"
        }
      }
    );
  }

  // ---- 13. MARQUEE — Scroll-responsive speed shift ----
  const marqueeTrack = document.querySelector('.marquee-track') as HTMLElement;
  if (marqueeTrack) {
    gsap.to(marqueeTrack, {
      x: "-=80",
      ease: "none",
      scrollTrigger: {
        trigger: '.marquee-section',
        start: "top bottom",
        end: "bottom top",
        scrub: 0.5
      }
    });
  }

  // ---- 14. MAP SECTION — Reveal with fade ----
  const mapSection = document.querySelector('.map-section') as HTMLElement;
  if (mapSection) {
    gsap.fromTo(mapSection,
      { opacity: 0 },
      {
        opacity: 1, duration: 1, ease: "power2.out",
        scrollTrigger: {
          trigger: mapSection,
          start: "top 85%",
          toggleActions: "play none none reverse"
        }
      }
    );
  }
</script>
