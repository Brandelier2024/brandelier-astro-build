---
// Header.astro — Shared site header
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about-us' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Careers', href: '/careers' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact-us' },
];
---

<header class:list={['site-header', { 'is-dark-hero': !isHome }]} id="site-header">
  <a class="brand-mark" href="/" aria-label="Brandelier home">BRANDELIER<span>.</span></a>
  <nav aria-label="Primary navigation">
    {navLinks.map(link => (
      <a href={link.href} class:list={[{ active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}>{link.label}</a>
    ))}
  </nav>
  <a class="header-cta" href="/contact-us">Start a project <span aria-hidden="true">↗</span></a>
  <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu" type="button">
    <span></span><span></span><span></span>
  </button>
</header>

<!-- Mobile nav overlay -->
<div class="mobile-nav-overlay" id="mobile-nav-overlay">
  <nav aria-label="Mobile navigation">
    {navLinks.map(link => (
      <a href={link.href} class:list={['mobile-nav-link', { active: currentPath === link.href }]}>{link.label}</a>
    ))}
    <a href="/contact-us" class="mobile-nav-cta">Start a project <span aria-hidden="true">↗</span></a>
  </nav>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn')!;
  const overlay = document.getElementById('mobile-nav-overlay')!;
  const header = document.getElementById('site-header')!;

  btn.addEventListener('click', () => {
    btn.classList.toggle('open');
    overlay.classList.toggle('open');
    document.body.style.overflow = overlay.classList.contains('open') ? 'hidden' : '';
  });

  overlay.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      btn.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    });
  });

  // Sticky header on scroll
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > 60) {
      header.classList.add('scrolled');
      header.classList.toggle('hide', y > lastScroll && y > 300);
    } else {
      header.classList.remove('scrolled', 'hide');
    }
    lastScroll = y;
  }, { passive: true });
</script>

<style>
  .site-header {
    align-items: center;
    display: flex;
    justify-content: space-between;
    padding: 24px 5vw;
    position: fixed;
    width: 100%;
    z-index: 100;
    top: 0;
    transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  }
  
  /* Default light page header styles (homepage top) */
  .brand-mark {
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: -.07em;
    text-decoration: none;
    transition: color .25s ease;
  }
  .brand-mark span { color: var(--pink); }
  
  nav { display: flex; gap: 2rem; margin-left: auto; margin-right: 3rem; }
  nav a, .header-cta {
    color: var(--ink);
    font-family: var(--font-body);
    font-size: .72rem;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color .2s, border-color .2s;
  }
  nav a:hover { color: var(--pink); }
  nav a.active { color: var(--pink); border-bottom: 1px solid var(--pink); padding-bottom: 4px; }
  .header-cta { border-bottom: 1px solid var(--ink); padding-bottom: 5px; }
  .header-cta:hover { color: var(--pink); border-color: var(--pink); }

  .mobile-menu-btn {
    display: none;
    background: none; border: none; cursor: pointer;
    flex-direction: column; gap: 5px; padding: 6px;
    z-index: 110;
  }
  .mobile-menu-btn span {
    display: block; width: 22px; height: 2px;
    background: var(--ink); transition: all .3s ease;
  }
  .mobile-menu-btn.open span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .mobile-menu-btn.open span:nth-child(2) { opacity: 0; }
  .mobile-menu-btn.open span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

  /* ========================================================
     DARK HERO THEME (Used on inner pages when at top of page)
     ======================================================== */
  .site-header.is-dark-hero:not(.scrolled) .brand-mark {
    color: var(--paper);
  }
  .site-header.is-dark-hero:not(.scrolled) nav a {
    color: rgba(244,247,255,.85);
  }
  .site-header.is-dark-hero:not(.scrolled) nav a:hover {
    color: var(--pink);
  }
  .site-header.is-dark-hero:not(.scrolled) nav a.active {
    color: var(--pink);
    border-bottom-color: var(--pink);
  }
  .site-header.is-dark-hero:not(.scrolled) .header-cta {
    color: var(--paper);
    border-color: rgba(244,247,255,.6);
  }
  .site-header.is-dark-hero:not(.scrolled) .header-cta:hover {
    color: var(--pink);
    border-color: var(--pink);
  }
  .site-header.is-dark-hero:not(.scrolled) .mobile-menu-btn:not(.open) span {
    background: var(--paper);
  }

  /* ========================================================
     SCROLLED STATE (Light frosted glass on all pages)
     ======================================================== */
  .site-header.scrolled {
    background: rgba(244,247,255,.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 4px 20px rgba(0,0,62,.06);
    padding: 16px 5vw;
  }
  .site-header.scrolled .brand-mark {
    color: var(--ink);
  }
  .site-header.scrolled nav a,
  .site-header.scrolled .header-cta {
    color: var(--ink);
  }
  .site-header.scrolled .header-cta {
    border-color: var(--ink);
  }
  .site-header.scrolled nav a:hover,
  .site-header.scrolled .header-cta:hover {
    color: var(--pink);
    border-color: var(--pink);
  }
  .site-header.scrolled .mobile-menu-btn span {
    background: var(--ink);
  }

  .site-header.hide { transform: translateY(-100%); }

  /* ========================================================
     MOBILE NAV OVERLAY
     ======================================================== */
  .mobile-nav-overlay {
    position: fixed; inset: 0; z-index: 99;
    background: var(--paper);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity .35s ease;
  }
  .mobile-nav-overlay.open { opacity: 1; pointer-events: all; }
  .mobile-nav-overlay nav {
    display: flex; flex-direction: column;
    align-items: center; gap: 1.6rem;
    margin: 0;
    max-height: 85vh;
    overflow-y: auto;
  }
  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 6vw, 3rem);
    color: var(--ink); text-decoration: none;
    font-weight: 500; letter-spacing: -.03em;
    transition: color .2s;
  }
  .mobile-nav-link:hover, .mobile-nav-link.active { color: var(--pink); }
  .mobile-nav-cta {
    font-family: var(--font-body); font-size: .75rem;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--paper); background: var(--ink);
    padding: 1rem 2rem; text-decoration: none;
    margin-top: 1rem; transition: background .2s;
  }
  .mobile-nav-cta:hover { background: var(--pink); }

  @media (max-width: 900px) {
    nav, .header-cta { display: none; }
    .mobile-menu-btn { display: flex; }
    .site-header { padding: 18px 20px; }
    .site-header.scrolled { padding: 14px 20px; }
  }
</style>
