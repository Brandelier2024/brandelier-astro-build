---
// PageHero.astro — Reusable dark hero banner for inner pages
interface Props {
  title: string;
  highlight?: string;
  description?: string;
  breadcrumb?: { label: string; href: string }[];
}

const { title, highlight, description, breadcrumb = [] } = Astro.props;
---

<section class="page-hero">
  {breadcrumb.length > 0 && (
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {breadcrumb.map(item => (
        <>
          <span class="sep" aria-hidden="true">→</span>
          <a href={item.href}>{item.label}</a>
        </>
      ))}
    </nav>
  )}
  <h1>{title}{highlight && <><br /><em>{highlight}</em></>}</h1>
  {description && <p class="hero-desc">{description}</p>}
  <div class="hero-decoration" aria-hidden="true"></div>
</section>

<style>
  .page-hero {
    background: var(--ink);
    color: var(--paper);
    padding: 12rem 10vw 6rem;
    position: relative;
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(221,46,184,.1) 0%, transparent 70%);
    pointer-events: none;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem;
    row-gap: .4rem;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
  }
  .breadcrumb a {
    font-family: var(--font-body);
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--blue-bell);
    text-decoration: none;
    transition: color .2s;
  }
  .breadcrumb a:last-child { color: rgba(244,247,255,.5); pointer-events: none; }
  .breadcrumb a:hover { color: var(--paper); }
  .sep { color: rgba(244,247,255,.25); font-size: .65rem; }
  h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 7.5vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -.05em;
    line-height: .92;
    margin: 0 0 1.5rem;
    position: relative;
    z-index: 1;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  h1 em {
    color: var(--pink);
    font-style: italic;
  }
  .hero-desc {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    color: rgba(244,247,255,.65);
    max-width: 560px;
    margin: 0;
    position: relative;
    z-index: 1;
  }
  .hero-decoration {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--blue-bell), var(--pink), transparent);
  }

  @media (max-width: 760px) {
    .page-hero {
      padding: 7.5rem 1.25rem 3.5rem;
    }
    .breadcrumb {
      margin-bottom: 1.25rem;
    }
    h1 {
      margin-bottom: 1rem;
      letter-spacing: -.03em;
    }
  }
</style>
