---
// PageHero.astro — Reusable dark hero banner for inner pages
interface Props {
  title: string;
  highlight?: string;
  description?: string;
  breadcrumb?: { label: string; href: string }[];
}

const { title, highlight, description, breadcrumb = [] } = Astro.props;
---

<section class="page-hero">
  {breadcrumb.length > 0 && (
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {breadcrumb.map(item => (
        <>
          <span class="sep">→</span>
          <a href={item.href}>{item.label}</a>
        </>
      ))}
    </nav>
  )}
  <h1>{title}{highlight && <><br /><em>{highlight}</em></>}</h1>
  {description && <p class="hero-desc">{description}</p>}
  <div class="hero-decoration" aria-hidden="true"></div>
</section>

<style>
  .page-hero {
    background: var(--ink);
    color: var(--paper);
    padding: 12rem 10vw 6rem;
    position: relative;
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(221,46,184,.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: .6rem;
    margin-bottom: 2rem;
  }
  .breadcrumb a {
    font-family: Arial, sans-serif;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--blue-bell);
    text-decoration: none;
    transition: color .2s;
  }
  .breadcrumb a:last-child { color: rgba(244,247,255,.5); }
  .breadcrumb a:hover { color: var(--paper); }
  .sep { color: rgba(244,247,255,.25); font-size: .65rem; }
  h1 {
    font-family: Georgia, serif;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 400;
    letter-spacing: -.06em;
    line-height: .88;
    margin: 0 0 1.5rem;
    position: relative;
    z-index: 1;
  }
  h1 em {
    color: var(--pink);
    font-style: italic;
  }
  .hero-desc {
    font-family: Georgia, serif;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.4;
    color: rgba(244,247,255,.6);
    max-width: 540px;
    margin: 0;
    position: relative;
    z-index: 1;
  }
  .hero-decoration {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--blue-bell), var(--pink), transparent);
  }

  @media (max-width: 760px) {
    .page-hero { padding: 10rem 20px 4rem; }
  }
</style>
