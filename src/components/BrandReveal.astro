---
// BrandReveal.astro — Scroll-driven 3D brand reveal intro
// High-performance, GPU-accelerated, responsive with gsap.matchMedia
import { Image } from 'astro:assets';
import heroPhoto from '../assets/images/_uploads/2026/08/Brandelier-.jpg-scaled.jpeg';
---

<section class="reveal-scroll-container" id="revealScrollContainer">
  <div class="reveal-sticky-scene" id="revealStickyScene">

    <!-- Ambient background aura glow -->
    <div class="reveal-bg-glow" aria-hidden="true"></div>

    <!-- Phase 1: Intro Headline -->
    <div class="reveal-intro-text" id="revealIntroText">
      <span class="reveal-intro-eyebrow">Creative Digital Agency · Pune</span>
      <h1 class="reveal-intro-h1">
        We create<br /><span class="reveal-pink-word">the brand.</span>
      </h1>
      <div class="reveal-scroll-prompt">
        <span class="reveal-mouse-icon">
          <span class="reveal-mouse-wheel"></span>
        </span>
        <span class="reveal-scroll-label">Scroll to explore</span>
      </div>
    </div>

    <!-- Phase 2a: Laptop Device (Desktop / Tablet) -->
    <div class="reveal-device-wrapper reveal-laptop-wrap" id="revealLaptop" aria-hidden="true">
      <div class="reveal-laptop-lid-container" id="revealLaptopLid">
        <div class="reveal-laptop-lid">
          <div class="reveal-laptop-camera"></div>
          
          <div class="reveal-screen-inner" id="revealLaptopScreen">
            <div class="reveal-screen-flash" id="revealLaptopFlash"></div>
            <div class="reveal-screen-logo" id="revealLaptopLogo">
              <span class="reveal-logo-text">BRANDELIER<span class="reveal-logo-dot">.</span></span>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal-laptop-base">
        <div class="reveal-laptop-notch"></div>
      </div>
      <div class="reveal-laptop-shadow" id="revealLaptopShadow"></div>
    </div>

    <!-- Phase 2b: Phone Device (Mobile) -->
    <div class="reveal-device-wrapper reveal-phone-wrap" id="revealPhone" aria-hidden="true">
      <div class="reveal-phone-body" id="revealPhoneBody">
        <div class="reveal-phone-notch"></div>
        <div class="reveal-screen-inner" id="revealPhoneScreen">
          <div class="reveal-screen-flash" id="revealPhoneFlash"></div>
          <div class="reveal-screen-logo" id="revealPhoneLogo">
            <span class="reveal-logo-text">BRANDELIER<span class="reveal-logo-dot">.</span></span>
          </div>
        </div>
      </div>
      <div class="reveal-phone-shadow" id="revealPhoneShadow"></div>
    </div>

    <!-- Phase 3: Hero Section Curtain (Revealed seamlessly upon zoom) -->
    <div class="reveal-hero-curtain" id="revealHeroCurtain">
      <div class="reveal-hero-content" id="revealHeroContent">
        
        <div class="reveal-hero-copy">
          <p class="reveal-hero-eyebrow">Creative digital agency · Pune / India</p>
          <h1 class="reveal-hero-heading">
            We create<br /><span class="reveal-pink-word">the brand.</span>
          </h1>
          <p class="reveal-hero-intro">
            At Brandelier, we fuse creativity and strategy to elevate brands in the digital world.
          </p>
          <div class="reveal-hero-actions">
            <a class="reveal-hero-link" href="#about">
              Discover Brandelier <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <div class="reveal-hero-visual" aria-label="Brandelier production team at work">
          <Image
            src={heroPhoto}
            alt="Brandelier production camera setup"
            class="reveal-hero-img"
            width={900}
            height={1100}
            format="webp"
            quality={82}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <span class="reveal-visual-note">Ideas in<br />motion</span>
          <span class="reveal-visual-index">01 / 04</span>
        </div>

      </div>

      <div class="reveal-hero-scroll-cue">
        Scroll to explore <span aria-hidden="true">↓</span>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let mm: ReturnType<typeof gsap.matchMedia> | null = null;

  function cleanupBrandReveal() {
    if (mm) {
      mm.revert();
      mm = null;
    }
  }

  function initBrandReveal() {
    cleanupBrandReveal();

    const container = document.getElementById('revealScrollContainer');
    if (!container) return;

    const header = document.getElementById('site-header');
    const laptop = document.getElementById('revealLaptop');
    const phone = document.getElementById('revealPhone');
    
    mm = gsap.matchMedia();

    // 1. Accessibility: Instant Hero for Reduced Motion Users
    mm.add('(prefers-reduced-motion: reduce)', () => {
      gsap.set('#revealIntroText', { autoAlpha: 0, display: 'none' });
      gsap.set(['#revealLaptop', '#revealPhone'], { autoAlpha: 0, display: 'none' });
      gsap.set('#revealHeroCurtain', { opacity: 1, pointerEvents: 'auto' });
      gsap.set('#revealHeroContent', { opacity: 1, y: 0 });
      if (header) header.classList.remove('is-dark-hero');
    });

    // 2. Desktop & Tablet: Sleek 3D Laptop Reveal (>= 768px)
    mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
      if (phone) phone.style.display = 'none';
      if (laptop) laptop.style.display = 'flex';

      // Set initial states
      gsap.set('#revealLaptop', { autoAlpha: 0, scale: 0.72 });
      gsap.set('#revealLaptopLid', { rotationX: -88 });
      gsap.set('#revealLaptopFlash', { opacity: 0 });
      gsap.set('#revealLaptopLogo', { opacity: 0 });
      gsap.set('#revealLaptopShadow', { opacity: 0.65 });
      gsap.set('#revealHeroCurtain', { opacity: 0, pointerEvents: 'none' });
      gsap.set('#revealHeroContent', { opacity: 0, y: 30 });

      let isDarkState = true;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: container,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.0,
          pin: false,
          onUpdate: (self) => {
            const shouldBeDark = self.progress <= 0.68;
            if (shouldBeDark !== isDarkState) {
              isDarkState = shouldBeDark;
              if (header) header.classList.toggle('is-dark-hero', isDarkState);
            }
          }
        }
      });

      tl
        // Step 1: Intro headline floats up & vanishes
        .to('#revealIntroText', {
          autoAlpha: 0,
          y: -45,
          scale: 0.95,
          duration: 1.5,
          ease: 'power2.inOut'
        })
        // Step 2: Sleek compact closed laptop fades in
        .to('#revealLaptop', {
          autoAlpha: 1,
          scale: 0.78,
          duration: 1.1,
          ease: 'power2.out'
        }, '-=0.3')
        // Step 3: Laptop lid opens smoothly & scales to 1.0 natural size
        .to('#revealLaptopLid', {
          rotationX: 0,
          duration: 1.8,
          ease: 'power2.inOut'
        })
        .to('#revealLaptop', {
          scale: 1.0,
          duration: 1.8,
          ease: 'power2.inOut'
        }, '<')
        // Step 4: Display screen flashes on and reveals BRANDELIER. logo
        .to('#revealLaptopFlash', {
          opacity: 0.95,
          duration: 0.22,
          ease: 'power1.out'
        })
        .to('#revealLaptopLogo', {
          opacity: 1,
          duration: 0.12
        })
        .to('#revealLaptopFlash', {
          opacity: 0,
          duration: 0.45,
          ease: 'power2.out'
        })
        .to({}, { duration: 0.4 }) // Pause to view lit logo
        // Step 5: Fade shadow & zoom deep into the display
        .to('#revealLaptopShadow', {
          opacity: 0,
          duration: 0.6,
          ease: 'power2.in'
        }, 'zoomStart')
        .to('#revealLaptop', {
          scale: 12,
          transformOrigin: '50% 43%',
          duration: 2.2,
          ease: 'power3.inOut'
        }, 'zoomStart')
        .to('#revealLaptopLogo', {
          opacity: 0,
          scale: 2.0,
          duration: 0.9,
          ease: 'power2.in'
        }, '-=1.4')
        // Step 6: Hero Curtain fades in seamlessly
        .to('#revealHeroCurtain', {
          opacity: 1,
          pointerEvents: 'auto',
          duration: 0.8,
          ease: 'power2.out'
        }, '-=0.7')
        .to('#revealHeroContent', {
          y: 0,
          opacity: 1,
          duration: 1.0,
          ease: 'power2.out'
        }, '-=0.4')
        // Deallocate massive 12x GPU transformed element once curtain covers screen
        .set('#revealLaptop', { autoAlpha: 0 })
        // Resting zone for hero content
        .to({}, { duration: 1.8 });
    });

    // 3. Mobile: Sleek 3D Smartphone Reveal (< 768px)
    mm.add('(max-width: 767px) and (prefers-reduced-motion: no-preference)', () => {
      if (laptop) laptop.style.display = 'none';
      if (phone) phone.style.display = 'flex';

      // Set initial states
      gsap.set('#revealPhone', { autoAlpha: 0, scale: 0.75 });
      gsap.set('#revealPhoneBody', { rotationX: 25 });
      gsap.set('#revealPhoneFlash', { opacity: 0 });
      gsap.set('#revealPhoneLogo', { opacity: 0 });
      gsap.set('#revealPhoneShadow', { opacity: 0.6 });
      gsap.set('#revealHeroCurtain', { opacity: 0, pointerEvents: 'none' });
      gsap.set('#revealHeroContent', { opacity: 0, y: 25 });

      let isDarkState = true;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: container,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.0,
          pin: false,
          onUpdate: (self) => {
            const shouldBeDark = self.progress <= 0.68;
            if (shouldBeDark !== isDarkState) {
              isDarkState = shouldBeDark;
              if (header) header.classList.toggle('is-dark-hero', isDarkState);
            }
          }
        }
      });

      tl
        .to('#revealIntroText', {
          autoAlpha: 0,
          y: -35,
          scale: 0.95,
          duration: 1.5,
          ease: 'power2.inOut'
        })
        .to('#revealPhone', {
          autoAlpha: 1,
          scale: 0.85,
          duration: 1.1,
          ease: 'power2.out'
        }, '-=0.3')
        .to('#revealPhoneBody', {
          rotationX: 0,
          duration: 1.8,
          ease: 'power2.inOut'
        })
        .to('#revealPhone', {
          scale: 1.0,
          duration: 1.8,
          ease: 'power2.inOut'
        }, '<')
        .to('#revealPhoneFlash', {
          opacity: 0.95,
          duration: 0.22,
          ease: 'power1.out'
        })
        .to('#revealPhoneLogo', {
          opacity: 1,
          duration: 0.12
        })
        .to('#revealPhoneFlash', {
          opacity: 0,
          duration: 0.45,
          ease: 'power2.out'
        })
        .to({}, { duration: 0.4 })
        .to('#revealPhoneShadow', {
          opacity: 0,
          duration: 0.6,
          ease: 'power2.in'
        }, 'zoomPhoneStart')
        .to('#revealPhone', {
          scale: 8.5,
          transformOrigin: '50% 50%',
          duration: 2.2,
          ease: 'power3.inOut'
        }, 'zoomPhoneStart')
        .to('#revealPhoneLogo', {
          opacity: 0,
          scale: 1.8,
          duration: 0.9,
          ease: 'power2.in'
        }, '-=1.4')
        .to('#revealHeroCurtain', {
          opacity: 1,
          pointerEvents: 'auto',
          duration: 0.8,
          ease: 'power2.out'
        }, '-=0.7')
        .to('#revealHeroContent', {
          y: 0,
          opacity: 1,
          duration: 1.0,
          ease: 'power2.out'
        }, '-=0.4')
        // Deallocate phone GPU transformed layer once curtain covers screen
        .set('#revealPhone', { autoAlpha: 0 })
        .to({}, { duration: 1.8 });
    });

    ScrollTrigger.refresh();
  }

  // Initialize on load and on Astro view transition navigation
  initBrandReveal();
  document.addEventListener('astro:page-load', initBrandReveal);
  document.addEventListener('astro:before-swap', cleanupBrandReveal);
  window.addEventListener('pagehide', cleanupBrandReveal);
</script>

<style>
  /* ================= CONTAINER & STICKY SCENE ================= */
  .reveal-scroll-container {
    width: 100%;
    height: 350vh;
    position: relative;
    background: var(--ink, #00003e);
  }

  .reveal-sticky-scene {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink, #00003e);
    perspective: 1200px;
    perspective-origin: 50% 50%;
  }

  /* Soft ambient background radial aura */
  .reveal-bg-glow {
    position: absolute;
    width: 65vw;
    height: 65vh;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(221, 46, 184, 0.12) 0%, rgba(63, 154, 230, 0.08) 45%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 1;
  }

  /* ================= PHASE 1: INTRO HEADLINE ================= */
  .reveal-intro-text {
    position: absolute;
    z-index: 10;
    text-align: center;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .reveal-intro-eyebrow {
    font-family: var(--font-body, 'Open Sans', sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(244, 247, 255, 0.65);
    margin-bottom: 1.5rem;
  }

  .reveal-intro-h1 {
    font-family: var(--font-heading, 'Montserrat', sans-serif);
    font-size: clamp(3.2rem, 7.5vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--paper, #f4f7ff);
    margin: 0 0 2.5rem;
  }

  .reveal-pink-word {
    color: var(--pink, #dd2eb8);
    font-style: normal;
  }

  .reveal-scroll-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    color: rgba(244, 247, 255, 0.5);
    font-family: var(--font-body, 'Open Sans', sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .reveal-mouse-icon {
    width: 20px;
    height: 32px;
    border: 2px solid rgba(244, 247, 255, 0.4);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 5px;
  }

  .reveal-mouse-wheel {
    width: 3px;
    height: 6px;
    background: var(--pink, #dd2eb8);
    border-radius: 2px;
    animation: mouseWheel 1.6s ease-in-out infinite;
  }

  @keyframes mouseWheel {
    0% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(10px); opacity: 0; }
  }

  /* ================= 3D DEVICE SHARED WRAPPER ================= */
  .reveal-device-wrapper {
    position: absolute;
    flex-direction: column;
    align-items: center;
    transform-style: preserve-3d;
    opacity: 0;
    z-index: 5;
    will-change: transform, opacity;
    backface-visibility: hidden;
    pointer-events: none;
  }

  /* Desktop Viewport (>= 768px): Laptop only */
  @media (min-width: 768px) {
    .reveal-laptop-wrap {
      display: flex;
    }
    .reveal-phone-wrap {
      display: none !important;
    }
  }

  /* Mobile Viewport (< 768px): Phone only */
  @media (max-width: 767px) {
    .reveal-laptop-wrap {
      display: none !important;
    }
    .reveal-phone-wrap {
      display: flex;
    }
  }

  /* ================= REFINED LAPTOP STYLES ================= */
  .reveal-laptop-lid-container {
    transform-style: preserve-3d;
    position: relative;
    z-index: 2;
    transform-origin: bottom center;
    will-change: transform;
    backface-visibility: hidden;
  }

  .reveal-laptop-lid {
    width: 460px;
    height: 290px;
    background: linear-gradient(145deg, #181c26 0%, #0d1017 100%);
    border-radius: 10px 10px 0 0;
    padding: 7px 7px 0 7px;
    box-shadow: 
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 10px 25px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    box-sizing: border-box;
    backface-visibility: hidden;
  }

  .reveal-laptop-camera {
    width: 4px;
    height: 4px;
    background: #050608;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    position: absolute;
    top: 3.5px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
  }

  .reveal-screen-inner {
    width: 100%;
    height: 100%;
    background: #030408;
    border-radius: 4px 4px 0 0;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 25px rgba(0, 0, 0, 0.95);
  }

  .reveal-screen-flash {
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: 0;
    z-index: 10;
    pointer-events: none;
  }

  .reveal-screen-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    z-index: 8;
  }

  .reveal-logo-text {
    font-family: var(--font-heading, 'Montserrat', sans-serif);
    font-weight: 900;
    font-size: 1.55rem;
    letter-spacing: 0.22em;
    color: #ffffff;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.25);
  }

  .reveal-logo-dot {
    color: var(--pink, #dd2eb8);
    text-shadow: 0 0 15px rgba(221, 46, 184, 0.8);
  }

  .reveal-laptop-base {
    width: 490px;
    height: 10px;
    background: linear-gradient(180deg, #282e3d 0%, #161a22 100%);
    border-radius: 0 0 8px 8px;
    position: relative;
    z-index: 1;
    margin-top: 1px;
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      0 12px 30px rgba(0, 0, 0, 0.85);
  }

  .reveal-laptop-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3.5px;
    background: #0f121a;
    border-radius: 0 0 4px 4px;
  }

  .reveal-laptop-shadow {
    width: 440px;
    height: 18px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.65);
    filter: blur(10px);
    margin-top: 5px;
  }

  /* ================= MOBILE PHONE STYLES ================= */
  .reveal-phone-body {
    width: 240px;
    height: 480px;
    background: linear-gradient(145deg, #1b202c 0%, #0d1017 100%);
    border-radius: 36px;
    padding: 10px;
    box-sizing: border-box;
    position: relative;
    box-shadow: 
      inset 0 0 0 2px rgba(255, 255, 255, 0.15),
      0 20px 45px rgba(0, 0, 0, 0.85);
    transform-style: preserve-3d;
    backface-visibility: hidden;
    will-change: transform;
  }

  .reveal-phone-notch {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 65px;
    height: 16px;
    background: #0b0d13;
    border-radius: 10px;
    z-index: 12;
  }

  .reveal-phone-body .reveal-screen-inner {
    border-radius: 28px;
  }

  .reveal-phone-body .reveal-logo-text {
    font-size: 1.25rem;
    letter-spacing: 0.18em;
  }

  .reveal-phone-shadow {
    width: 200px;
    height: 20px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    filter: blur(10px);
    margin-top: 10px;
  }

  /* ================= PHASE 3: HERO CURTAIN ================= */
  .reveal-hero-curtain {
    position: absolute;
    inset: 0;
    background: var(--paper, #f4f7ff);
    opacity: 0;
    pointer-events: none;
    z-index: 20;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 110px 5vw 50px;
    box-sizing: border-box;
    overflow: hidden;
    will-change: opacity;
  }

  .reveal-hero-content {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4vw;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    will-change: transform, opacity;
  }

  .reveal-hero-copy {
    position: relative;
    z-index: 2;
  }

  .reveal-hero-eyebrow {
    font-family: var(--font-body, 'Open Sans', sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted, #53647d);
    margin-bottom: 1.2rem;
  }

  .reveal-hero-heading {
    font-family: var(--font-heading, 'Montserrat', sans-serif);
    font-size: clamp(3rem, 6.2vw, 6.8rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.92;
    color: var(--ink, #00003e);
    margin: 0 0 1.6rem;
  }

  .reveal-hero-intro {
    font-family: var(--font-body, 'Open Sans', sans-serif);
    font-size: clamp(1.05rem, 1.4vw, 1.35rem);
    line-height: 1.55;
    color: var(--muted, #53647d);
    max-width: 32rem;
    margin: 0 0 2rem;
  }

  .reveal-hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .reveal-hero-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-body, 'Open Sans', sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink, #00003e);
    border-bottom: 1px solid var(--ink, #00003e);
    padding-bottom: 0.5rem;
    transition: color 0.25s, border-color 0.25s;
  }

  .reveal-hero-link:hover {
    color: var(--pink, #dd2eb8);
    border-color: var(--pink, #dd2eb8);
  }

  /* Right column: Tilted Visual Card */
  .reveal-hero-visual {
    position: relative;
    min-height: 460px;
    height: 56vh;
    max-height: 600px;
    border-radius: 12px;
    overflow: hidden;
    transform: rotate(3deg);
    background: var(--caramel, #f1a966);
    box-shadow: 0 20px 45px rgba(0, 0, 62, 0.12);
  }

  .reveal-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    display: block;
  }

  .reveal-visual-note {
    position: absolute;
    bottom: 12%;
    right: 8%;
