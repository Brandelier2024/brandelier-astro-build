---
// BrandReveal.astro — Scroll-driven 3D brand reveal intro
// High-performance, GPU-accelerated, responsive with gsap.matchMedia
import { Image } from 'astro:assets';
import heroPhoto1 from '../assets/images/_uploads/2026/08/Brandelier-.jpg-scaled.jpeg';
import heroPhoto2 from '../assets/images/_uploads/2026/08/Brandelier-1.jpg-scaled.jpeg';
import heroPhoto3 from '../assets/images/_uploads/2026/08/Brandelier-2.jpg-scaled.jpeg';
import heroPhoto4 from '../assets/images/_uploads/2026/08/Brandelier-3.jpg-scaled.jpeg';

const heroCards = [
  {
    id: 1,
    image: heroPhoto1,
    alt: "Brandelier commercial camera production setup",
    index: "01 / 04",
    note: "Ideas in<br />motion",
    tag: "Production",
  },
  {
    id: 2,
    image: heroPhoto2,
    alt: "Brandelier cinematography and filming crew on set",
    index: "02 / 04",
    note: "Lights on<br />camera ready",
    tag: "Cinematography",
  },
  {
    id: 3,
    image: heroPhoto3,
    alt: "Brandelier studio interview and video production setup",
    index: "03 / 04",
    note: "Real stories<br />real impact",
    tag: "Storytelling",
  },
  {
    id: 4,
    image: heroPhoto4,
    alt: "Brandelier close-up detail and product cinematography",
    index: "04 / 04",
    note: "Every detail<br />matters",
    tag: "Creative Craft",
  },
];
---

<section class="reveal-scroll-container" id="revealScrollContainer">
  <div class="reveal-sticky-scene" id="revealStickyScene">

    <!-- Ambient background aura glow -->
    <div class="reveal-bg-glow" aria-hidden="true"></div>

    <!-- Phase 1: Intro Headline -->
    <div class="reveal-intro-text" id="revealIntroText">
      <span class="reveal-intro-eyebrow">Creative Digital Agency · Pune</span>
      <h1 class="reveal-intro-h1">
        We create<br /><span class="reveal-pink-word">the brand.</span>
      </h1>
      <div class="reveal-scroll-prompt">
        <span class="reveal-mouse-icon">
          <span class="reveal-mouse-wheel"></span>
        </span>
        <span class="reveal-scroll-label">Scroll to explore</span>
      </div>
    </div>

    <!-- Phase 2a: Laptop Device (Desktop / Tablet) -->
    <div class="reveal-device-wrapper reveal-laptop-wrap" id="revealLaptop" aria-hidden="true">
      <div class="reveal-laptop-lid-container" id="revealLaptopLid">
        <div class="reveal-laptop-lid">
          <div class="reveal-laptop-camera"></div>
          
          <div class="reveal-screen-inner" id="revealLaptopScreen">
            <div class="reveal-screen-flash" id="revealLaptopFlash"></div>
            <div class="reveal-screen-logo" id="revealLaptopLogo">
              <span class="reveal-logo-text">BRANDELIER<span class="reveal-logo-dot">.</span></span>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal-laptop-base">
        <div class="reveal-laptop-notch"></div>
      </div>
      <div class="reveal-laptop-shadow" id="revealLaptopShadow"></div>
    </div>

    <!-- Phase 2b: Phone Device (Mobile) -->
    <div class="reveal-device-wrapper reveal-phone-wrap" id="revealPhone" aria-hidden="true">
      <div class="reveal-phone-body" id="revealPhoneBody">
        <div class="reveal-phone-notch"></div>
        <div class="reveal-screen-inner" id="revealPhoneScreen">
          <div class="reveal-screen-flash" id="revealPhoneFlash"></div>
          <div class="reveal-screen-logo" id="revealPhoneLogo">
            <span class="reveal-logo-text">BRANDELIER<span class="reveal-logo-dot">.</span></span>
          </div>
        </div>
      </div>
      <div class="reveal-phone-shadow" id="revealPhoneShadow"></div>
    </div>

    <!-- Phase 3: Hero Section Curtain (Revealed seamlessly upon zoom) -->
    <div class="reveal-hero-curtain" id="revealHeroCurtain">
      <div class="reveal-hero-content" id="revealHeroContent">
        
        <div class="reveal-hero-copy">
          <p class="reveal-hero-eyebrow">Creative digital agency · Pune / India</p>
          <h1 class="reveal-hero-heading">
            We create<br /><span class="reveal-pink-word">the brand.</span>
          </h1>
          <p class="reveal-hero-intro">
            At Brandelier, we fuse creativity and strategy to elevate brands in the digital world.
          </p>
          <div class="reveal-hero-actions">
            <a class="reveal-hero-link" href="#about">
              Discover Brandelier <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <!-- Automatic Card Stacking Showcase (Multiple Photos) -->
        <div class="reveal-hero-deck" id="revealHeroDeck" aria-label="Brandelier creative production photo cards">
          <div class="deck-cards-viewport" id="deckCardsViewport">
            {heroCards.map((card, idx) => (
              <article
                class="deck-photo-card"
                data-card-idx={idx}
                data-depth={idx}
                tabindex="0"
                role="button"
                aria-label={`Photo ${idx + 1} of ${heroCards.length}: ${card.tag}. Click to view next photo.`}
              >
                <div class="deck-photo-inner">
                  <Image
                    src={card.image}
                    alt={card.alt}
                    class="deck-card-img"
                    width={900}
                    height={1100}
                    format="webp"
                    quality={82}
                    loading={idx === 0 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={idx === 0 ? "high" : "auto"}
                  />
                  <div class="deck-card-vignette" aria-hidden="true"></div>
                  <span class="deck-card-tag">{card.tag}</span>
                  <span class="reveal-visual-note"><Fragment set:html={card.note} /></span>
                  <span class="reveal-visual-index">{card.index}</span>
                </div>
              </article>
            ))}
          </div>

          <!-- Deck controls (Dots with auto-timer progress + sleek Prev/Next controls) -->
          <div class="deck-controls">
            <div class="deck-dots" role="tablist" aria-label="Deck photo selection">
              {heroCards.map((_, idx) => (
                <button
                  type="button"
                  class={`deck-dot ${idx === 0 ? 'is-active' : ''}`}
                  data-target-idx={idx}
                  aria-label={`Switch to photo ${idx + 1}`}
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                >
                  <span class="deck-dot-progress"></span>
                </button>
              ))}
            </div>

            <div class="deck-arrows">
              <button type="button" class="deck-arrow-btn" id="deckPrevBtn" aria-label="Previous card">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 18l-6-6 6-6"/>
                </svg>
              </button>
              <button type="button" class="deck-arrow-btn" id="deckNextBtn" aria-label="Next card">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

      </div>

      <div class="reveal-hero-scroll-cue">
        Scroll to explore <span aria-hidden="true">↓</span>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let mm: ReturnType<typeof gsap.matchMedia> | null = null;

  // ================= AUTOMATIC STACKED CARD CONTROLLER =================
  let deckTimer: ReturnType<typeof setInterval> | null = null;
  let activeDeckIndex = 0;
  let isDeckAnimating = false;
  let isDeckPaused = false;
  let deckTouchStartX = 0;
  let deckTouchStartY = 0;
  let visibilityListenerAttached = false;
  const DECK_CYCLE_MS = 3800;

  function stopDeckAutoplay() {
    if (deckTimer) {
      clearInterval(deckTimer);
      deckTimer = null;
    }
  }

  function startDeckAutoplay() {
    stopDeckAutoplay();
    if (isDeckPaused) return;

    deckTimer = setInterval(() => {
      dealDeckNext();
    }, DECK_CYCLE_MS);

    resetProgressAnimation();
  }

  function resetProgressAnimation() {
    const dots = document.querySelectorAll<HTMLElement>('.deck-dot');
    dots.forEach((dot, idx) => {
      const fill = dot.querySelector<HTMLElement>('.deck-dot-progress');
      if (!fill) return;
      if (idx === activeDeckIndex) {
        fill.style.animation = 'none';
        void fill.offsetHeight; // trigger reflow
        fill.style.animation = `deckProgress ${DECK_CYCLE_MS}ms linear forwards`;
        fill.style.animationPlayState = isDeckPaused ? 'paused' : 'running';
      } else {
        fill.style.animation = 'none';
        fill.style.transform = idx < activeDeckIndex ? 'scaleX(1)' : 'scaleX(0)';
      }
    });
  }

  function updateDeckSlots(dealOutCardIdx: number | null = null) {
    const cards = document.querySelectorAll<HTMLElement>('.deck-photo-card');
    const total = cards.length;
    if (total === 0) return;

    cards.forEach((card, idx) => {
      if (idx === dealOutCardIdx) return;
      const depth = (idx - activeDeckIndex + total) % total;
      card.setAttribute('data-depth', String(depth));
      card.setAttribute('aria-hidden', depth === 0 ? 'false' : 'true');
      card.classList.remove('is-dealing-out', 'is-dealing-in', 'is-swooping-in');
    });

    const dots = document.querySelectorAll<HTMLElement>('.deck-dot');
    dots.forEach((dot, idx) => {
      const isActive = idx === activeDeckIndex;
      dot.classList.toggle('is-active', isActive);
      dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });
  }

  function dealDeckNext() {
    const cards = document.querySelectorAll<HTMLElement>('.deck-photo-card');
    const total = cards.length;
    if (total <= 1 || isDeckAnimating) return;

    isDeckAnimating = true;
    const oldActiveIdx = activeDeckIndex;
    const oldCard = cards[oldActiveIdx];
    const newActiveIdx = (activeDeckIndex + 1) % total;

    if (oldCard) {
      oldCard.classList.add('is-dealing-out');
    }

    activeDeckIndex = newActiveIdx;
    updateDeckSlots(oldActiveIdx);
    resetProgressAnimation();

    setTimeout(() => {
      if (oldCard) {
        oldCard.classList.remove('is-dealing-out');
        oldCard.classList.add('is-dealing-in');
        oldCard.setAttribute('data-depth', String(total - 1));
        oldCard.setAttribute('aria-hidden', 'true');
        void oldCard.offsetHeight; // force reflow
        oldCard.classList.remove('is-dealing-in');
      }
      isDeckAnimating = false;
    }, 450);

    startDeckAutoplay();
  }

  function dealDeckPrev() {
    const cards = document.querySelectorAll<HTMLElement>('.deck-photo-card');
    const total = cards.length;
    if (total <= 1 || isDeckAnimating) return;

    isDeckAnimating = true;
    const prevIdx = (activeDeckIndex - 1 + total) % total;
    const incomingCard = cards[prevIdx];

    if (incomingCard) {
      incomingCard.classList.add('is-swooping-in');
      incomingCard.setAttribute('data-depth', '0');
      incomingCard.setAttribute('aria-hidden', 'false');
    }

    activeDeckIndex = prevIdx;
    updateDeckSlots(prevIdx);
    resetProgressAnimation();

    setTimeout(() => {
      if (incomingCard) {
        incomingCard.classList.remove('is-swooping-in');
      }
      isDeckAnimating = false;
      updateDeckSlots();
    }, 450);

    startDeckAutoplay();
  }

  function jumpToDeckIndex(targetIdx: number) {
    if (targetIdx === activeDeckIndex || isDeckAnimating) return;
    const cards = document.querySelectorAll<HTMLElement>('.deck-photo-card');
    const total = cards.length;
    if (targetIdx < 0 || targetIdx >= total) return;

    isDeckAnimating = true;
    const oldCard = cards[activeDeckIndex];
    if (oldCard) {
      oldCard.classList.add('is-dealing-out');
    }
    activeDeckIndex = targetIdx;
    updateDeckSlots(targetIdx);
    resetProgressAnimation();

    setTimeout(() => {
      if (oldCard) {
        oldCard.classList.remove('is-dealing-out');
      }
      updateDeckSlots();
      isDeckAnimating = false;
    }, 420);

    startDeckAutoplay();
  }

  function setupDeckInteractions() {
    const deckElement = document.getElementById('revealHeroDeck');
    if (!deckElement) return;

    // Hover pause / play
    deckElement.addEventListener('mouseenter', () => {
      isDeckPaused = true;
      stopDeckAutoplay();
      const activeFill = document.querySelector<HTMLElement>('.deck-dot.is-active .deck-dot-progress');
      if (activeFill) activeFill.style.animationPlayState = 'paused';
    });

    deckElement.addEventListener('mouseleave', () => {
      isDeckPaused = false;
      const activeFill = document.querySelector<HTMLElement>('.deck-dot.is-active .deck-dot-progress');
      if (activeFill) activeFill.style.animationPlayState = 'running';
      startDeckAutoplay();
    });

    // Click cards viewport to deal next card
    const viewport = document.getElementById('deckCardsViewport');
    if (viewport) {
      viewport.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.deck-arrow-btn') || target.closest('.deck-dot')) return;
        dealDeckNext();
      });
    }

    // Touch swipe support
    deckElement.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        deckTouchStartX = e.touches[0].clientX;
        deckTouchStartY = e.touches[0].clientY;
      }
    }, { passive: true });

    deckElement.addEventListener('touchend', (e) => {
      if (e.changedTouches.length > 0) {
        const dx = e.changedTouches[0].clientX - deckTouchStartX;
        const dy = e.changedTouches[0].clientY - deckTouchStartY;
        if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
          if (dx < 0) {
            dealDeckNext();
          } else {
            dealDeckPrev();
          }
        }
      }
    }, { passive: true });

    // Prev / Next button clicks
    const prevBtn = document.getElementById('deckPrevBtn');
    const nextBtn = document.getElementById('deckNextBtn');
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dealDeckPrev();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dealDeckNext();
      });
    }

    // Dot navigation clicks
    const dots = document.querySelectorAll<HTMLElement>('.deck-dot');
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = Number(dot.dataset.targetIdx);
        if (!isNaN(target)) jumpToDeckIndex(target);
      });
    });

    // Keyboard support on card deck
    deckElement.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === ' ') {
        e.preventDefault();
        dealDeckNext();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        dealDeckPrev();
      }
    });

    // Handle tab visibility so background tab doesn't cycle rapidly
    if (!visibilityListenerAttached) {
      visibilityListenerAttached = true;
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopDeckAutoplay();
        } else {
          if (!isDeckPaused) startDeckAutoplay();
        }
      });
    }

    // Initialize initial visual slots & start timer
    updateDeckSlots();
    startDeckAutoplay();
  }

  function cleanupBrandReveal() {
    stopDeckAutoplay();
    if (mm) {
      mm.revert();
      mm = null;
    }
  }

  function initBrandReveal() {
    cleanupBrandReveal();

    const container = document.getElementById('revealScrollContainer');
    if (!container) return;

    const header = document.getElementById('site-header');
    const laptop = document.getElementById('revealLaptop');
    const phone = document.getElementById('revealPhone');
    
    mm = gsap.matchMedia();

    // 1. Accessibility: Instant Hero for Reduced Motion Users
    mm.add('(prefers-reduced-motion: reduce)', () => {
      gsap.set('#revealIntroText', { autoAlpha: 0, display: 'none' });
      gsap.set(['#revealLaptop', '#revealPhone'], { autoAlpha: 0, display: 'none' });
      gsap.set('#revealHeroCurtain', { opacity: 1, pointerEvents: 'auto' });
      gsap.set('#revealHeroContent', { opacity: 1, y: 0 });
      if (header) {
        header.classList.remove('is-dark-hero');
        header.classList.add('entered');
      }
    });

    // 2. Desktop & Tablet: Sleek 3D Laptop Reveal (>= 768px)
    mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
      if (phone) phone.style.display = 'none';
      if (laptop) laptop.style.display = 'flex';

      // Set initial states
      gsap.set('#revealLaptop', { autoAlpha: 0, scale: 0.72 });
      gsap.set('#revealLaptopLid', { rotationX: -88 });
      gsap.set('#revealLaptopFlash', { opacity: 0 });
      gsap.set('#revealLaptopLogo', { opacity: 0 });
      gsap.set('#revealLaptopShadow', { opacity: 0.65 });
      gsap.set('#revealHeroCurtain', { opacity: 0, pointerEvents: 'none' });
      gsap.set('#revealHeroContent', { opacity: 0, y: 30 });

      let isDarkState = true;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: container,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.0,
          pin: false,
          onUpdate: (self) => {
            const shouldBeDark = self.progress <= 0.68;
            if (shouldBeDark !== isDarkState) {
              isDarkState = shouldBeDark;
              if (header) header.classList.toggle('is-dark-hero', isDarkState);
            }
            if (header) {
              header.classList.toggle('entered', self.progress >= 0.70);
            }
          }
        }
      });

      tl
        // Step 1: Intro headline floats up & vanishes
        .to('#revealIntroText', {
          autoAlpha: 0,
          y: -45,
          scale: 0.95,
          duration: 1.5,
          ease: 'power2.inOut'
        })
        // Step 2: Sleek compact closed laptop fades in
        .to('#revealLaptop', {
          autoAlpha: 1,
          scale: 0.78,
          duration: 1.1,
          ease: 'power2.out'
        }, '-=0.3')
        // Step 3: Laptop lid opens smoothly & scales to 1.0 natural size
        .to('#revealLaptopLid', {
          rotationX: 0,
          duration: 1.8,
          ease: 'power2.inOut'
        })
        .to('#revealLaptop', {
          scale: 1.0,
          duration: 1.8,
          ease: 'power2.inOut'
        }, '<')
        // Step 4: Display screen flashes on and reveals BRANDELIER. logo
        .to('#revealLaptopFlash', {
          opacity: 0.95,
          duration: 0.22,
          ease: 'power1.out'
        })
        .to('#revealLaptopLogo', {
          opacity: 1,
          duration: 0.12
        })
        .to('#revealLaptopFlash', {
          opacity: 0,
          duration: 0.45,
          ease: 'power2.out'
        })
        .to({}, { duration: 0.4 }) // Pause to view lit logo
        // Step 5: Fade shadow & zoom deep into the display
        .to('#revealLaptopShadow', {
          opacity: 0,
          duration: 0.6,
          ease: 'power2.in'
        }, 'zoomStart')
        .to('#revealLaptop', {
          scale: 12,
          transformOrigin: '50% 43%',
          duration: 2.2,
          ease: 'power3.inOut'
        }, 'zoomStart')
        .to('#revealLaptopLogo', {
          opacity: 0,
          scale: 2.0,
          duration: 0.9,
          ease: 'power2.in'
        }, '-=1.4')
        // Step 6: Hero Curtain fades in seamlessly
        .to('#revealHeroCurtain', {
          opacity: 1,
          pointerEvents: 'auto',
          duration: 0.8,
          ease: 'power2.out'
        }, '-=0.7')
        .to('#revealHeroContent', {
          y: 0,
          opacity: 1,
          duration: 1.0,
          ease: 'power2.out'
        }, '-=0.4')
        // Deallocate massive 12x GPU transformed element once curtain covers screen
        .set('#revealLaptop', { autoAlpha: 0 })
        // Resting zone for hero content
        .to({}, { duration: 1.8 });
    });

    // 3. Mobile: Sleek 3D Smartphone Reveal (< 768px)
    mm.add('(max-width: 767px) and (prefers-reduced-motion: no-preference)', () => {
      if (laptop) laptop.style.display = 'none';
      if (phone) phone.style.display = 'flex';

      // Set initial states
      gsap.set('#revealPhone', { autoAlpha: 0, scale: 0.75 });
      gsap.set('#revealPhoneBody', { rotationX: 25 });
      gsap.set('#revealPhoneFlash', { opacity: 0 });
      gsap.set('#revealPhoneLogo', { opacity: 0 });
      gsap.set('#revealPhoneShadow', { opacity: 0.6 });
      gsap.set('#revealHeroCurtain', { opacity: 0, pointerEvents: 'none' });
      gsap.set('#revealHeroContent', { opacity: 0, y: 25 });

      let isDarkState = true;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: container,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.0,
          pin: false,
          onUpdate: (self) => {
            const shouldBeDark = self.progress <= 0.68;
            if (shouldBeDark !== isDarkState) {
              isDarkState = shouldBeDark;
              if (header) header.classList.toggle('is-dark-hero', isDarkState);
            }
            if (header) {
              header.classList.toggle('entered', self.progress >= 0.70);
            }
          }
        }
      });

      tl
        .to('#revealIntroText', {
          autoAlpha: 0,
          y: -35,
          scale: 0.95,
          duration: 1.5,
          ease: 'power2.inOut'
        })
        .to('#revealPhone', {
          autoAlpha: 1,
          scale: 0.85,
          duration: 1.1,
          ease: 'power2.out'
        }, '-=0.3')
        .to('#revealPhoneBody', {
          rotationX: 0,
          duration: 1.8,
          ease: 'power2.inOut'
        })
        .to('#revealPhone', {
          scale: 1.0,
          duration: 1.8,
          ease: 'power2.inOut'
        }, '<')
        .to('#revealPhoneFlash', {
          opacity: 0.95,
          duration: 0.22,
          ease: 'power1.out'
        })
        .to('#revealPhoneLogo', {
          opacity: 1,
          duration: 0.12
        })
        .to('#revealPhoneFlash', {
          opacity: 0,
          duration: 0.45,
          ease: 'power2.out'
        })
        .to({}, { duration: 0.4 })
        .to('#revealPhoneShadow', {
          opacity: 0,
          duration: 0.6,
          ease: 'power2.in'
        }, 'zoomPhoneStart')
        .to('#revealPhone', {
          scale: 8.5,
          transformOrigin: '50% 50%',
          duration: 2.2,
          ease: 'power3.inOut'
        }, 'zoomPhoneStart')
        .to('#revealPhoneLogo', {
          opacity: 0,
          scale: 1.8,
          duration: 0.9,
          ease: 'power2.in'
        }, '-=1.4')
        .to('#revealHeroCurtain', {
          opacity: 1,
          pointerEvents: 'auto',
          duration: 0.8,
          ease: 'power2.out'
        }, '-=0.7')
        .to('#revealHeroContent', {
          y: 0,
          opacity: 1,
          duration: 1.0,
          ease: 'power2.out'
        }, '-=0.4')
        // Deallocate phone GPU transformed layer once curtain covers screen
        .set('#revealPhone', { autoAlpha: 0 })
        .to({}, { duration: 1.8 });
    });

    ScrollTrigger.refresh();
    setupDeckInteractions();
  }

  // Initialize on load and on Astro view transition navigation
  initBrandReveal();
  document.addEventListener('astro:page-load', initBrandReveal);
  document.addEventListener('astro:before-swap', cleanupBrandReveal);
  window.addEventListener('pagehide', cleanupBrandReveal);
</script>

<style>
  /* ================= CONTAINER & STICKY SCENE ================= */
  .reveal-scroll-container {
    width: 100%;
