---
// Footer.astro — Shared site footer
const year = new Date().getFullYear();

const serviceLinks = [
  { label: 'Social Media Marketing', href: '/services/social-media-marketing' },
  { label: 'Web Development', href: '/services/web-development' },
  { label: 'SEO Optimization', href: '/services/seo-optimization' },
  { label: 'Videography & Photography', href: '/services/videography-photography' },
  { label: 'Content Marketing', href: '/services/content-marketing' },
  { label: 'Brand Design', href: '/services/brand-design' },
];

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Careers', href: '/careers' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact Us', href: '/contact-us' },
];
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="brand-mark" href="/">BRANDELIER<span>.</span></a>
      <p class="footer-tagline">Inspiring change, one brand at a time.</p>
      <p class="footer-desc">Brandelier Media Works is a results-driven digital marketing company in Pune offering SEO, social media, branding & web services to grow your business online.</p>
      <div class="footer-socials">
        <a href="https://www.instagram.com/brandelier.in/?hl=en" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/brandelier-in/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.facebook.com/brandelier" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-links-col">
      <h4>Quick Links</h4>
      <ul>
        {quickLinks.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-links-col">
      <h4>Our Services</h4>
      <ul>
        {serviceLinks.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-contact-col">
      <h4>Get in Touch</h4>
      <div class="footer-contact-item">
        <span class="footer-contact-label">Email</span>
        <a href="mailto:Info@brandelier.in">Info@brandelier.in</a>
      </div>
      <div class="footer-contact-item">
        <span class="footer-contact-label">Phone</span>
        <a href="tel:+917058670837">+91 70586 70837</a>
      </div>
      <div class="footer-contact-item">
        <span class="footer-contact-label">Office</span>
        <span>403, West Avenue, Near Bremen Chowk, Aundh, Pune – 411067</span>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <small>© {year} Brandelier MediaWorks LLP. All rights reserved.</small>
    <div class="footer-bottom-links">
      <a href="/services">Services</a>
      <a href="/about-us">About</a>
      <a href="/contact-us">Contact</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    padding: 0;
  }
  .footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 4rem;
    padding: 5rem 5vw 3rem;
  }
  .brand-mark {
    color: var(--paper);
    font-family: Arial, sans-serif;
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: -.07em;
    text-decoration: none;
  }
  .brand-mark span { color: var(--pink); }
  .footer-tagline {
    font-family: Georgia, serif;
    font-size: 1.1rem;
    font-style: italic;
    color: var(--caramel);
    margin: 1rem 0 .5rem;
  }
  .footer-desc {
    font-family: Arial, sans-serif;
    font-size: .8rem;
    line-height: 1.6;
    color: rgba(244,247,255,.55);
    max-width: 320px;
  }
  .footer-socials {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .footer-socials a {
    color: rgba(244,247,255,.5);
    transition: color .2s, transform .2s;
  }
  .footer-socials a:hover {
    color: var(--pink);
    transform: translateY(-2px);
  }
  .footer-links-col h4, .footer-contact-col h4 {
    font-family: Arial, sans-serif;
    font-size: .7rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--blue-bell);
    margin: 0 0 1.5rem;
  }
  .footer-links-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-links-col li { margin-bottom: .8rem; }
  .footer-links-col a {
    color: rgba(244,247,255,.6);
    font-family: Arial, sans-serif;
    font-size: .78rem;
    text-decoration: none;
    transition: color .2s;
    letter-spacing: .02em;
  }
  .footer-links-col a:hover { color: var(--paper); }
  .footer-contact-item {
    margin-bottom: 1.2rem;
  }
  .footer-contact-label {
    display: block;
    font-family: Arial, sans-serif;
    font-size: .65rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(244,247,255,.35);
    margin-bottom: .3rem;
  }
  .footer-contact-item a, .footer-contact-item span {
    color: rgba(244,247,255,.7);
    font-family: Arial, sans-serif;
    font-size: .8rem;
    text-decoration: none;
    line-height: 1.5;
  }
  .footer-contact-item a:hover { color: var(--caramel); }
  .footer-bottom {
    border-top: 1px solid rgba(63,154,230,.15);
    padding: 1.5rem 5vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .footer-bottom small {
    font-family: Arial, sans-serif;
    font-size: .68rem;
    color: rgba(244,247,255,.35);
    letter-spacing: .06em;
  }
  .footer-bottom-links {
    display: flex;
    gap: 1.5rem;
  }
  .footer-bottom-links a {
    font-family: Arial, sans-serif;
    font-size: .68rem;
    color: rgba(244,247,255,.4);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: .1em;
    transition: color .2s;
  }
  .footer-bottom-links a:hover { color: var(--paper); }

  @media (max-width: 960px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 3rem 2rem;
    }
  }
  @media (max-width: 600px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 3rem 20px 2rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: .8rem;
      text-align: center;
      padding: 1.5rem 20px;
    }
  }
</style>
