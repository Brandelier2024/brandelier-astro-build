---
// Layout.astro — Shared page layout
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Brandelier Media Works is a results-driven digital marketing company in Pune offering SEO, social media, branding & web services to grow your business online.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --ink: #00003e;
    --paper: #f4f7ff;
    --blue-bell: #3f9ae6;
    --violet: #9b2fca;
    --pink: #dd2eb8;
    --caramel: #ebad74;
    --muted: #53647d;
    --line: rgba(0,0,62,.2);
  }
  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    overflow-x: hidden;
    width: 100%;
    -webkit-font-smoothing: antialiased;
  }
  * { box-sizing: border-box; }
  img { max-width: 100%; height: auto; }
  a { transition: color .2s ease; }
</style>
