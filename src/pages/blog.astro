---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { getPosts, type BlogPost } from "../lib/wp";

// Fetch live blog posts from Headless WordPress (cms.brandelier.in)
const articles: BlogPost[] = await getPosts();
const featured = articles[0];
const remaining = articles.slice(1);

// Extract distinct categories from fetched articles
const allCategories = [
  "All",
  ...Array.from(new Set(articles.flatMap((a) => a.categories).filter(Boolean))),
];
---

<Layout
  title="Blog – Marketing Insights & Creative Ideas | Brandelier"
  description="Read insights on digital marketing, social media growth, SEO tips, brand strategy, and video production from Brandelier Media Works."
>
  <PageHero
    title="Insights,"
    highlight="ideas & craft."
    description="Fresh perspectives on marketing, design, storytelling, and digital growth from the Brandelier team."
    breadcrumb={[{ label: "Blog", href: "/blog" }]}
  />

  <section class="blog-section">
    {
      featured && (
        <article class="featured-post">
          <div class="featured-img-wrap">
            <a href={featured.href}>
              <img src={featured.image} alt={featured.title} loading="eager" />
            </a>
            <span class="featured-badge">Featured Read</span>
          </div>
          <div class="featured-content">
            <div class="meta-row">
              <span class="cat-tag">{featured.category}</span>
              <span class="meta-dot">·</span>
              <span class="meta-time">{featured.readTime}</span>
            </div>
            <h2>{featured.title}</h2>
            <p>{featured.excerpt}</p>
            <a href={featured.href} class="read-more-link">
              Read Full Story <span>↗</span>
            </a>
          </div>
        </article>
      )
    }

    <!-- Category Filter Bar -->
    {
      allCategories.length > 2 && (
        <div class="category-filter-bar">
          <span class="filter-label">Filter by:</span>
          <div class="category-pills">
            {allCategories.map((cat, idx) => (
              <button
                type="button"
                class={`cat-filter-btn ${idx === 0 ? "active" : ""}`}
                data-category={cat}
              >
                {cat}
              </button>
            ))}
          </div>
        </div>
      )
    }

    <!-- Articles Grid Heading -->
    <div class="articles-grid-heading">
      <p class="section-label">Latest Articles</p>
      <h2>Explore all<br /><em>perspectives.</em></h2>
    </div>

    <!-- Articles Grid -->
    <div class="articles-grid" id="articlesGrid">
      {
        remaining.map((article) => (
          <article
            class="article-card"
            data-categories={JSON.stringify(article.categories)}
          >
            <div class="article-thumb">
              <a href={article.href} class="card-link">
                <img src={article.image} alt={article.title} loading="lazy" />
              </a>
              <span class="cat-pill">{article.category}</span>
            </div>
            <div class="article-body">
              <div class="card-meta">
                <span>{article.date}</span>
                <span>·</span>
                <span>{article.readTime}</span>
              </div>
              <a href={article.href}>
                <h3>{article.title}</h3>
              </a>
              <p>{article.excerpt}</p>
              <a href={article.href} class="card-link">
                Read Article <span>↗</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="newsletter-section">
    <div class="newsletter-card">
      <p class="section-label">Stay in the loop</p>
      <h2>Get creative insights<br /><em>delivered monthly.</em></h2>
      <p class="newsletter-desc">
        Zero spam. Just thoughtful breakdowns of marketing trends, case studies,
        and brand strategies.
      </p>
      <form
        class="newsletter-form"
        onsubmit="event.preventDefault(); alert('Thank you for subscribing! You will receive our next monthly dispatch.');"
      >
        <input type="email" placeholder="Enter your business email" required />
        <button type="submit">Subscribe ↗</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  // Interactive Category Filter
  const filterBtns = document.querySelectorAll(".cat-filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".article-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const selectedCat = btn.getAttribute("data-category");

      cards.forEach((card) => {
        if (!selectedCat || selectedCat === "All") {
          card.style.display = "flex";
        } else {
          try {
            const cardCats = JSON.parse(
              card.getAttribute("data-categories") || "[]",
            );
            if (cardCats.includes(selectedCat)) {
              card.style.display = "flex";
            } else {
              card.style.display = "none";
            }
          } catch {
            card.style.display = "flex";
          }
        }
      });
    });
  });
</script>

<style>
  .section-label {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h2 {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
    padding-bottom: 0.12em;
    overflow: visible;
    margin: 1.25rem 0 2rem;
  }
  h2 em {
    color: var(--pink);
    font-style: normal;
  }

  .blog-section {
    padding: 3rem 5vw;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Featured Post */
  .featured-post {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 2.5rem;
    background: white;
    margin-bottom: 5rem;
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
    box-shadow: 0 10px 30px rgba(0, 0, 62, 0.04);
  }
  .featured-post:hover {
    border-color: var(--pink);
    box-shadow: 0 25px 60px rgba(221, 46, 184, 0.12);
  }
  .featured-img-wrap {
    position: relative;
    height: 420px;
    border-radius: 16px;
    overflow: hidden;
    background: #e9efff;
  }
  .featured-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .featured-post:hover .featured-img-wrap img {
    transform: scale(1.03);
  }

  .featured-badge {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 0.9rem;
    border-radius: 100px;
    font-weight: 700;
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }
  .cat-tag {
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink);
    font-weight: bold;
  }
  .meta-dot {
    color: var(--muted);
  }
  .meta-time {
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .featured-content h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin: 0 0 1rem;
  }
  .featured-content p {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 1.2rem 0 2rem;
    text-align: justify;
    text-justify: inter-word;
  }
  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1.5px solid var(--pink);
    padding-bottom: 0.4rem;
    font-weight: 700;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .read-more-link:hover {
    color: var(--pink);
  }

  /* Category Filter Bar */
  .category-filter-bar {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 4rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2rem;
  }
  .filter-label {
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .category-pills {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .cat-filter-btn {
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 6px 16px;
    border-radius: 100px;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .cat-filter-btn:hover {
    border-color: var(--pink);
    color: var(--pink);
  }
  .cat-filter-btn.active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  /* Articles Grid */
  .articles-grid-heading {
    margin-bottom: 3.5rem;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .article-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: white;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
    box-shadow: 0 8px 25px rgba(0, 0, 62, 0.03);
  }
  .article-card:hover {
    transform: translateY(-5px);
    border-color: var(--pink);
    box-shadow: 0 15px 40px rgba(221, 46, 184, 0.12);
  }
  .article-thumb {
    position: relative;
    height: 220px;
    overflow: hidden;
    background: #e9efff;
  }
  .article-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .article-card:hover .article-thumb img {
    transform: scale(1.05);
  }
  .cat-pill {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(0, 0, 62, 0.85);
    backdrop-filter: blur(8px);
    color: white;
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 100px;
    font-weight: 600;
  }
  .article-body {
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .card-meta {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.68rem;
    color: var(--muted);
    margin-bottom: 0.8rem;
  }
  .article-body h3 {
    font-family: var(--font-heading);
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.8rem;
    color: var(--ink);
  }
  .article-body p {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 1.5rem;
    flex-grow: 1;
    text-align: justify;
    text-justify: inter-word;
  }
  .card-link {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    transition: color 0.2s;
  }
  .card-link:hover {
    color: var(--ink);
  }

  /* Newsletter */
  .newsletter-section {
    background: var(--ink);
    padding: 7rem 10vw;
    color: var(--paper);
  }
  .newsletter-card {
    max-width: 650px;
    margin: 0 auto;
    text-align: center;
  }
  .newsletter-card .section-label {
    color: var(--blue-bell);
  }
  .newsletter-desc {
    font-size: 1.05rem;
    color: rgba(244, 247, 255, 0.65);
    margin: 1.5rem 0 2.5rem;
    line-height: 1.5;
  }
  .newsletter-form {
    display: flex;
    gap: 1rem;
    max-width: 480px;
    margin: 0 auto;
  }
  .newsletter-form input {
    flex-grow: 1;
    padding: 1rem 1.4rem;
    border-radius: 100px;
    border: 1px solid rgba(244, 247, 255, 0.2);
    background: rgba(244, 247, 255, 0.06);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
  }
  .newsletter-form input:focus {
    border-color: var(--pink);
  }
  .newsletter-form button {
    padding: 1rem 2rem;
    border-radius: 100px;
    border: none;
    background: var(--pink);
    color: white;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s;
    white-space: nowrap;
    font-weight: 700;
  }
  .newsletter-form button:hover {
    background: #be1c9c;
  }

  @media (max-width: 960px) {
    .featured-post {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 1.5rem;
    }
    .featured-img-wrap {
      height: 300px;
    }
    .articles-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 760px) {
    .blog-section,
    .newsletter-section {
      padding: 4rem 20px;
    }
    .articles-grid {
      grid-template-columns: 1fr;
    }
    .newsletter-form {
      flex-direction: column;
    }
    .newsletter-form button {
      width: 100%;
    }
  }
</style>
