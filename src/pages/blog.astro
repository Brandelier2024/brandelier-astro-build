---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import PageHero from '../components/PageHero.astro';

const articles = [
  {
    title: 'What you need to know to launch your brand on social media?',
    category: 'Social Media',
    date: 'Aug 2025',
    readTime: '4 min read',
    excerpt: 'Launching a brand on social media requires more than just making an account and posting logos. Discover the foundational pillars of visual tone, audience alignment, and content scheduling that ensure an impactful launch.',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/TAG@LENSSHIMMMER-08596-scaled.jpg'
  },
  {
    title: 'The Best Time to Post on Instagram? Spoiler: It’s Not When You Think!',
    category: 'Analytics',
    date: 'Jul 2025',
    readTime: '5 min read',
    excerpt: 'Generic posting schedules rarely deliver consistent reach. We break down algorithmic signals, audience active hours, and data testing strategies tailored to Indian D2C and service brands.',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/TAG@LENSSHIMMMER-00268-scaled.jpg'
  },
  {
    title: '10 Essential Marketing Services Every Business Needs',
    category: 'Strategy',
    date: 'Jun 2025',
    readTime: '6 min read',
    excerpt: 'From high-intent SEO to thumb-stopping short form video, understand the modern marketing mix required to establish competitive advantage in today’s attention economy.',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/Brandelier-.jpg-scaled.jpeg'
  },
  {
    title: 'Maximize Your Market Potential with Unique Branding Strategies',
    category: 'Branding',
    date: 'May 2025',
    readTime: '5 min read',
    excerpt: 'How visual differentiation and clear point-of-view messaging allow emerging brands to escape commodity pricing and capture genuine customer loyalty.',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/Brandelier-3.jpg-scaled.jpeg'
  },
  {
    title: 'Boost Your Brand with Professional Product Photography',
    category: 'Production',
    date: 'Apr 2025',
    readTime: '4 min read',
    excerpt: 'High-converting product imagery is the foundation of digital commerce. Learn how lighting, composition, and lifestyle contexts directly influence customer trust and checkout velocity.',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/WhatsApp-Image-2026-08-25-at-2.02.42-AM.jpeg'
  },
  {
    title: 'Interactive Content: Why Quizzes, Polls Are Driving Engagement',
    category: 'Content Marketing',
    date: 'Mar 2025',
    readTime: '5 min read',
    excerpt: 'Passive consumption is fading. Discover how gamified story polls, interactive quizzes, and engagement stickers are unlocking exponential organic reach across platforms.',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/TAG@LENSSHIMMMER-08585-scaled.jpg'
  }
];

const categories = ['All', 'Social Media', 'Analytics', 'Strategy', 'Branding', 'Production', 'Content Marketing'];
---

<Layout title="Blog – Marketing Insights & Creative Ideas | Brandelier" description="Read insights on digital marketing, social media growth, SEO tips, brand strategy, and video production from Brandelier Media Works.">

  <PageHero
    title="Insights,"
    highlight="ideas & craft."
    description="Fresh perspectives on marketing, design, storytelling, and digital growth from the Brandelier team."
    breadcrumb={[{ label: 'Blog', href: '/blog' }]}
  />

  <section class="blog-section">
    <!-- Featured Hero Post -->
    <article class="featured-post">
      <div class="featured-img-wrap">
        <Image src={articles[0].image} alt={articles[0].title} width={900} height={600} loading="lazy" />
        <span class="featured-badge">Featured Read</span>
      </div>
      <div class="featured-content">
        <div class="meta-row">
          <span class="cat-tag">{articles[0].category}</span>
          <span class="meta-dot">·</span>
          <span class="meta-time">{articles[0].readTime}</span>
        </div>
        <h2>{articles[0].title}</h2>
        <p>{articles[0].excerpt}</p>
        <a href="#read" class="read-more-link">Read Full Story <span>↗</span></a>
      </div>
    </article>

    <!-- Articles Grid -->
    <div class="articles-grid-heading">
      <p class="section-label">Latest Articles</p>
      <h2>Explore all<br /><em>perspectives.</em></h2>
    </div>

    <div class="articles-grid">
      {articles.slice(1).map(article => (
        <article class="article-card">
          <div class="article-thumb">
            <Image src={article.image} alt={article.title} width={600} height={400} loading="lazy" />
            <span class="cat-pill">{article.category}</span>
          </div>
          <div class="article-body">
            <div class="card-meta">
              <span>{article.date}</span>
              <span>·</span>
              <span>{article.readTime}</span>
            </div>
            <h3>{article.title}</h3>
            <p>{article.excerpt}</p>
            <a href="#read" class="card-link">Read Article <span>↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="newsletter-section">
    <div class="newsletter-card">
      <p class="section-label">Stay in the loop</p>
      <h2>Get creative insights<br /><em>delivered monthly.</em></h2>
      <p class="newsletter-desc">Zero spam. Just thoughtful breakdowns of marketing trends, case studies, and brand strategies.</p>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing!');">
        <input type="email" placeholder="Enter your business email" required />
        <button type="submit">Subscribe ↗</button>
      </form>
    </div>
  </section>

</Layout>

<style>
  .section-label { font-family: Arial, sans-serif; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  h2 { font-family: Georgia, serif; font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 400; letter-spacing: -.06em; line-height: .92; margin: 1rem 0; }
  h2 em { color: var(--pink); font-style: italic; }

  .blog-section { padding: 6rem 10vw; }

  /* Featured Post */
  .featured-post {
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 4rem;
    align-items: center; border: 1px solid var(--line);
    border-radius: 24px; padding: 2.5rem; background: white;
    margin-bottom: 7rem; transition: border-color .3s, box-shadow .3s;
  }
  .featured-post:hover { border-color: var(--pink); box-shadow: 0 25px 60px rgba(0,0,62,.06); }
  .featured-img-wrap { position: relative; height: 420px; border-radius: 16px; overflow: hidden; }
  .featured-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .featured-badge {
    position: absolute; top: 1.5rem; left: 1.5rem;
    background: var(--ink); color: var(--paper);
    font-family: Arial, sans-serif; font-size: .65rem;
    letter-spacing: .1em; text-transform: uppercase;
    padding: .4rem .9rem; border-radius: 100px;
  }
  .meta-row { display: flex; align-items: center; gap: .8rem; margin-bottom: 1rem; }
  .cat-tag {
    font-family: Arial, sans-serif; font-size: .68rem;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--pink); font-weight: bold;
  }
  .meta-dot { color: var(--muted); }
  .meta-time { font-family: Arial, sans-serif; font-size: .72rem; color: var(--muted); }
  .featured-content p { font-family: Arial, sans-serif; font-size: .95rem; line-height: 1.6; color: var(--muted); margin: 1.2rem 0 2rem; }
  .read-more-link {
    display: inline-flex; align-items: center; gap: .6rem;
    font-family: Arial, sans-serif; font-size: .75rem;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--ink);
    padding-bottom: .4rem; transition: color .2s, border-color .2s;
  }
  .read-more-link:hover { color: var(--pink); border-color: var(--pink); }

  /* Articles Grid */
  .articles-grid-heading { margin-bottom: 3.5rem; }
  .articles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  .article-card {
    border: 1px solid var(--line); border-radius: 18px;
    background: white; overflow: hidden; display: flex; flex-direction: column;
    transition: transform .3s, border-color .3s, box-shadow .3s;
  }
  .article-card:hover { transform: translateY(-5px); border-color: var(--pink); box-shadow: 0 15px 40px rgba(0,0,62,.06); }
  .article-thumb { position: relative; height: 220px; overflow: hidden; }
  .article-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .article-card:hover .article-thumb img { transform: scale(1.05); }
  .cat-pill {
    position: absolute; bottom: 1rem; left: 1rem;
    background: rgba(0,0,62,.85); backdrop-filter: blur(8px);
    color: white; font-family: Arial, sans-serif; font-size: .62rem;
    letter-spacing: .08em; text-transform: uppercase;
    padding: .3rem .7rem; border-radius: 100px;
  }
  .article-body { padding: 1.8rem; display: flex; flex-direction: column; flex-grow: 1; }
  .card-meta { display: flex; gap: .5rem; font-family: Arial, sans-serif; font-size: .68rem; color: var(--muted); margin-bottom: .8rem; }
  .article-body h3 { font-family: Georgia, serif; font-size: 1.25rem; font-weight: 400; line-height: 1.25; margin: 0 0 .8rem; }
  .article-body p { font-family: Arial, sans-serif; font-size: .82rem; line-height: 1.5; color: var(--muted); margin: 0 0 1.5rem; flex-grow: 1; }
  .card-link {
    font-family: Arial, sans-serif; font-size: .72rem;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink); text-decoration: none;
    display: inline-flex; align-items: center; gap: .4rem;
    transition: color .2s;
  }
  .card-link:hover { color: var(--pink); }

  /* Newsletter */
  .newsletter-section { background: var(--ink); padding: 7rem 10vw; color: var(--paper); }
  .newsletter-card { max-width: 650px; margin: 0 auto; text-align: center; }
  .newsletter-card .section-label { color: var(--blue-bell); }
  .newsletter-desc { font-size: 1.05rem; color: rgba(244,247,255,.65); margin: 1.5rem 0 2.5rem; line-height: 1.5; }
  .newsletter-form { display: flex; gap: 1rem; max-width: 480px; margin: 0 auto; }
  .newsletter-form input {
    flex-grow: 1; padding: 1rem 1.4rem; border-radius: 100px;
    border: 1px solid rgba(244,247,255,.2); background: rgba(244,247,255,.06);
    color: var(--paper); font-family: Georgia, serif; font-size: .95rem; outline: none;
  }
  .newsletter-form input:focus { border-color: var(--pink); }
  .newsletter-form button {
    padding: 1rem 2rem; border-radius: 100px; border: none;
    background: var(--pink); color: white; font-family: Arial, sans-serif;
    font-size: .75rem; letter-spacing: .1em; text-transform: uppercase;
    cursor: pointer; transition: background .3s; white-space: nowrap;
  }
  .newsletter-form button:hover { background: #be1c9c; }

  @media (max-width: 960px) {
    .featured-post { grid-template-columns: 1fr; gap: 2rem; padding: 1.5rem; }
    .featured-img-wrap { height: 300px; }
    .articles-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .blog-section, .newsletter-section { padding: 4rem 20px; }
    .articles-grid { grid-template-columns: 1fr; }
    .newsletter-form { flex-direction: column; }
    .newsletter-form button { width: 100%; }
  }
</style>
