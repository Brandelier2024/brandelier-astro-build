---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import BtsExperience from '../components/BtsExperience.astro';
import BeaneryModal from '../components/BeaneryModal.astro';

const services = [
  ['01', 'Performance Marketing', 'Campaigns engineered to turn attention into measurable growth.', '/services/social-media-marketing'],
  ['02', 'Social Media Growth', 'A sharper social presence built around your audience and your voice.', '/services/social-media-marketing'],
  ['03', 'Content Marketing', 'Stories, systems, and useful content that keep your brand in motion.', '/services/content-marketing'],
  ['04', 'Web Development', 'Beautiful, functional, user-first digital experiences.', '/services/web-development'],
  ['05', 'Brand Strategy', 'A clear point of view that makes every future decision easier.', '/services/brand-design'],
  ['06', 'SEO Optimization', 'Thoughtful digital experiences that help more visits become action.', '/services/seo-optimization']
];

const approach = [
  ['01', 'Discovery & Strategy', 'Research-driven strategies tailored to your audience and market.'],
  ['02', 'Design & Development', 'Beautiful, functional, user-first digital experiences.'],
  ['03', 'Marketing & Promotion', 'Cross-platform promotion to build awareness and drive results.'],
  ['04', 'Monitoring & Optimization', 'Data-led refinement to keep improving performance.']
];

const stats = [
  { number: '6+', label: 'Years of Experience' },
  { number: '100+', label: 'Happy Clients' },
  { number: '20+', label: 'Team Members' },
  { number: '500+', label: 'Projects Delivered' },
];

const marqueeItems = [
  'Performance Marketing', 'Social Media', 'SEO', 'Brand Design',
  'Content Marketing', 'Web Development', 'Videography', 'Photography'
];

const featuredBlogs = [
  {
    title: 'What you need to know to launch your brand on social media?',
    category: 'Social Media',
    date: 'Aug 2025',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/TAG@LENSSHIMMMER-08596-scaled.jpg',
    href: '/blog'
  },
  {
    title: 'The Best Time to Post on Instagram? Spoiler: It’s Not When You Think!',
    category: 'Analytics',
    date: 'Jul 2025',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/TAG@LENSSHIMMMER-00268-scaled.jpg',
    href: '/blog'
  },
  {
    title: '10 Essential Marketing Services Every Business Needs',
    category: 'Strategy',
    date: 'Jun 2025',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/Brandelier-.jpg-scaled.jpeg',
    href: '/blog'
  }
];
---

<Layout title="Best Digital Marketing Company in Pune | Brandelier.in" description="Brandelier Media Works is a results-driven digital marketing company in Pune offering SEO, social media, branding & web services to grow your business online.">

  <section class="hero-section" id="top">
    <div class="hero-copy">
      <p class="eyebrow">Creative digital agency · Pune / India</p>
      <h1>We create<br /><em>the brand.</em></h1>
      <p class="hero-intro">At Brandelier, we fuse creativity and strategy to elevate brands in the digital world.</p>
      <a class="text-link" href="/about-us">Discover Brandelier <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-visual" aria-label="Brandelier production team at work">
      <Image src="https://brandelier.in/wp-content/uploads/2026/08/Brandelier-.jpg-scaled.jpeg" alt="Brandelier production camera setup" width={1200} height={1400} loading="eager" />
      <span class="visual-note">Ideas in<br />motion</span><span class="visual-index">01 / 04</span>
    </div>
    <div class="hero-scroll">Scroll to explore <span aria-hidden="true">↓</span></div>
  </section>

  <!-- Marquee Section -->
  <div class="marquee-section">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems, ...marqueeItems].map(item => (
        <span class="marquee-item">{item} <span class="marquee-dot">✦</span></span>
      ))}
    </div>
  </div>

  <section class="statement-section" id="about">
    <div class="section-label">01 — The brandelier way</div>
    <div class="statement-grid">
      <h2>Make noise.<br /><span>Mean more.</span></h2>
      <div><p class="large-copy">We help ambitious businesses grow with innovation and impact. With 6+ years of experience and a team of 20+ professionals, we make brands impossible to ignore.</p><a class="text-link dark-link" href="/contact-us">Let's make something matter <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="stats-grid">
      {stats.map(stat => (
        <div class="stat-item">
          <span class="stat-number">{stat.number}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="services-section" id="services">
    <div class="section-heading"><div class="section-label">02 — What we do best</div><h2>Strategy with<br /><em>style.</em></h2></div>
    <div class="service-list">
      {services.map(([number, title, description, href]) => (
        <a href={href} class="service-row">
          <span class="service-number">{number}</span>
          <h3>{title}</h3>
          <p>{description}</p>
          <span class="service-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="proof-section">
    <div class="proof-image"><Image src="https://brandelier.in/wp-content/uploads/2026/08/WhatsApp-Image-2026-08-25-at-2.02.42-AM.jpeg" alt="Brandelier team working on set" width={900} height={1200} loading="lazy" /><span>02 / On set</span></div>
    <div class="proof-copy"><p class="section-label">03 — Behind the brand</p><h2>Ideas are<br /><em>better lived.</em></h2><p>From the first messy thought to the final polished frame, we bring strategy, craft, and a little bit of magic to every brief.</p><div class="proof-stats"><strong>20+</strong><span>curious minds<br />making things happen</span></div></div>
  </section>

  <BtsExperience />

  <section class="case-section" id="work">
    <div class="section-label">04 — Case study spotlight</div>
    <div class="case-grid"><div><p class="case-kicker">Beanery Café · Content production</p><h2>Crafting the story<br /><em>behind the brand.</em></h2><p class="large-copy">We captured the energy, details, and personality that make Beanery feel alive. Every frame was thoughtfully crafted to reflect a premium yet inviting identity.</p><button class="outline-button open-gallery-btn" type="button">Explore Beanery BTS <span aria-hidden="true">↗</span></button></div><div class="case-image"><Image src="https://brandelier.in/wp-content/uploads/2026/08/WhatsApp-Image-2026-08-25-at-2.02.42-AM.jpeg" alt="Beanery Café content production" width={900} height={900} loading="lazy" /><span>@beanerycafe</span></div></div>
  </section>

  <section class="approach-section"><div class="section-heading"><div class="section-label">05 — Our approach</div><h2>Good work,<br /><em>on purpose.</em></h2></div><div class="approach-grid">{approach.map(([number, title, description]) => <article><span>{number}</span><h3>{title}</h3><p>{description}</p></article>)}</div></section>

  <!-- Careers / Work With Us Section -->
  <section class="careers-teaser-section">
    <div class="careers-teaser-grid">
      <div>
        <p class="section-label">06 — Join the collective</p>
        <h2>Make work that<br /><em>cannot be ignored.</em></h2>
      </div>
      <div>
        <p class="large-copy">We are constantly seeking ambitious storytellers, video editors, designers, and growth strategists to join our studio in Pune.</p>
        <div class="careers-teaser-actions">
          <a href="/careers" class="text-link">Explore open positions <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Insights / Blog Section -->
  <section class="home-blog-section">
    <div class="section-heading">
      <div>
        <p class="section-label">07 — Fresh perspectives</p>
        <h2>Latest from<br /><em>the studio.</em></h2>
      </div>
      <a href="/blog" class="text-link view-all-link">All articles <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-blog-grid">
      {featuredBlogs.map(post => (
        <a href={post.href} class="home-blog-card">
          <div class="home-blog-image">
            <Image src={post.image} alt={post.title} width={600} height={400} loading="lazy" />
            <span class="home-blog-cat">{post.category}</span>
          </div>
          <div class="home-blog-content">
            <span class="home-blog-date">{post.date}</span>
            <h3>{post.title}</h3>
            <span class="home-blog-read">Read Article ↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA / Contact Section -->
  <section class="contact-section" id="contact"><p class="section-label">08 — Make a move</p><h2>Have a brand<br /><em>worth talking about?</em></h2><a class="contact-email" href="mailto:Info@brandelier.in">Info@brandelier.in <span aria-hidden="true">↗</span></a><div class="contact-meta"><a href="tel:+917058670837">+91 70586 70837</a><span>Pune, Maharashtra</span></div></section>

  <BeaneryModal />
</Layout>

<style>
  /* =================== HERO =================== */
  .hero-section { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; overflow: hidden; padding: 150px 5vw 70px; position: relative; }.hero-copy { align-self: center; padding-right: 5vw; position: relative; z-index: 2; }
  .eyebrow, .section-label, .case-kicker, .hero-scroll, .visual-index, .visual-note, .proof-image span, .case-image span { font-family: var(--font-body); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; }.eyebrow, .section-label { color: var(--muted); }
  h1, h2 { font-family: var(--font-heading); font-size: clamp(3.5rem, 8.5vw, 8.5rem); font-weight: 500; letter-spacing: -.05em; line-height: .88; margin: 2rem 0; } h1 em, h2 em, .statement-grid h2 span { color: var(--pink); font-style: normal; }
  .hero-intro { font-size: clamp(1.15rem, 1.7vw, 1.45rem); line-height: 1.5; margin: 2rem 0; max-width: 28rem; }.text-link { border-bottom: 1px solid var(--ink); color: var(--ink); display: inline-flex; font-family: var(--font-body); font-size: .72rem; gap: 1.2rem; letter-spacing: .12em; padding-bottom: .6rem; text-decoration: none; text-transform: uppercase; }
  .hero-visual { background: var(--caramel); min-height: 620px; overflow: hidden; position: relative; transform: rotate(3deg) translate(2vw, 2vw); }.hero-visual img, .proof-image img, .case-image img { height: 100%; object-fit: cover; width: 100%; }.hero-visual img { filter: saturate(.85); }.visual-note { background: var(--blue-bell); color: var(--ink); bottom: 12%; padding: 1rem; position: absolute; right: 10%; }.visual-index { bottom: 5%; color: var(--paper); left: 8%; position: absolute; }.hero-scroll { bottom: 4rem; left: 5vw; position: absolute; }.hero-scroll span { font-size: 1.2rem; margin-left: 1rem; }

  /* =================== MARQUEE =================== */
  .marquee-section { background: var(--ink); padding: 1.2rem 0; overflow: hidden; }
  .marquee-track {
    display: flex; gap: 0; white-space: nowrap;
    animation: marquee 30s linear infinite;
  }
  .marquee-item {
    font-family: var(--font-heading); font-size: .75rem;
    font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase;
    color: rgba(244,247,255,.5); padding: 0 1.5rem;
    flex-shrink: 0;
  }
  .marquee-dot { color: var(--pink); margin: 0 .5rem; font-size: .6rem; }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }

  /* =================== STATEMENT =================== */
  .statement-section, .services-section, .case-section, .approach-section, .careers-teaser-section, .home-blog-section, .contact-section { padding: 9rem 10vw; }
  .statement-section, .case-section, .contact-section { background: var(--ink); color: var(--paper); }
  .statement-section .section-label, .case-section .section-label, .contact-section .section-label { color: var(--blue-bell); }
  .statement-grid, .case-grid, .careers-teaser-grid { display: grid; gap: 10vw; grid-template-columns: 1fr 1fr; }
  .statement-grid h2, .case-grid h2, .careers-teaser-grid h2 { font-size: clamp(3.5rem, 7vw, 7rem); margin: 4rem 0 0; }
  .large-copy { font-size: clamp(1.25rem, 2vw, 1.8rem); line-height: 1.35; max-width: 35rem; }
  .dark-link { border-color: var(--paper); color: var(--paper); margin-top: 2rem; }

  /* =================== STATS =================== */
  .stats-section {
    background: linear-gradient(135deg, var(--ink) 0%, #0a0a4e 100%);
    padding: 5rem 10vw;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }
  .stat-item {
    padding: 2rem;
    border: 1px solid rgba(63,154,230,.15);
    border-radius: 16px;
    background: rgba(244,247,255,.03);
    transition: transform .3s, border-color .3s;
  }
  .stat-item:hover {
    transform: translateY(-4px);
    border-color: var(--pink);
  }
  .stat-number {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(3rem, 5vw, 4.5rem);
    color: var(--paper);
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: 1;
    margin-bottom: .5rem;
  }
  .stat-label {
    font-family: var(--font-body);
    font-size: .75rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--blue-bell);
  }

  /* =================== SERVICES =================== */
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; }
  .section-heading h2 { font-size: clamp(3.5rem, 7vw, 7rem); margin: 0; }
  .service-list { border-top: 1px solid var(--line); margin-top: 7rem; }
  .service-row { align-items: center; border-bottom: 1px solid var(--line); display: grid; gap: 2rem; grid-template-columns: 5rem 1.2fr 1fr 2rem; padding: 2rem 0; text-decoration: none; color: var(--ink); transition: background .2s; }
  .service-row:hover { background: rgba(221,46,184,.04); }
  .service-number, .approach-grid article > span { color: var(--muted); font-family: var(--font-heading); font-size: .75rem; font-weight: 700; }
  .service-row h3, .approach-grid h3 { font-family: var(--font-heading); font-size: clamp(1.3rem, 2.2vw, 2rem); font-weight: 600; margin: 0; }
  .service-row p, .approach-grid p, .proof-copy > p:not(.section-label) { color: var(--muted); font-size: 1rem; line-height: 1.5; margin: 0; }
  .service-arrow { font-size: 1.7rem; text-align: right; transition: transform .2s; }
  .service-row:hover .service-arrow { transform: translate(3px, -3px); }

  /* =================== PROOF =================== */
  .proof-section { display: grid; grid-template-columns: 1fr 1fr; min-height: 720px; }
  .proof-image { min-height: 600px; position: relative; }
  .proof-image span, .case-image span { bottom: 1.5rem; color: white; left: 1.5rem; position: absolute; }
  .proof-copy { align-self: center; padding: 8vw; }
  .proof-copy h2 { font-size: clamp(3.5rem, 6vw, 6.5rem); }
  .proof-stats { align-items: center; border-top: 1px solid var(--line); display: flex; gap: 1rem; margin-top: 4rem; padding-top: 1.5rem; }
  .proof-stats strong { font-size: 4rem; font-weight: 700; font-family: var(--font-heading); }
  .proof-stats span { color: var(--muted); font-family: var(--font-body); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }

  /* =================== CASE =================== */
  .case-grid { margin-top: 4rem; }
  .case-grid h2 { color: var(--paper); font-size: clamp(3rem, 6vw, 6rem); }
  .case-kicker { color: var(--caramel); }
  .case-image { height: 560px; overflow: hidden; position: relative; }
  .case-image img { filter: saturate(.9); }
  .outline-button { background: transparent; border: 1px solid var(--blue-bell); color: var(--paper); cursor: pointer; font-family: var(--font-body); font-size: .75rem; letter-spacing: .12em; padding: 1rem 1.25rem; text-transform: uppercase; transition: background .2s, border-color .2s; }
  .outline-button span { margin-left: 1.5rem; }
  .outline-button:hover { background: rgba(63,154,230,.15); border-color: var(--paper); }

  /* =================== APPROACH =================== */
  .approach-grid { border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 7rem; }
  .approach-grid article { border-right: 1px solid var(--line); min-height: 250px; padding: 1.5rem; }
  .approach-grid article:first-child { padding-left: 0; }
  .approach-grid article:last-child { border: 0; }
  .approach-grid h3 { margin: 4rem 0 1rem; }

  /* =================== CAREERS TEASER =================== */
  .careers-teaser-section { border-top: 1px solid var(--line); background: white; }
  .careers-teaser-actions { margin-top: 2.5rem; }

  /* =================== LATEST BLOG =================== */
  .home-blog-section { border-top: 1px solid var(--line); }
  .view-all-link { margin-bottom: 1rem; }
  .home-blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; margin-top: 5rem; }
  .home-blog-card {
    text-decoration: none; color: var(--ink); border: 1px solid var(--line);
    border-radius: 16px; overflow: hidden; background: white;
    transition: transform .3s, border-color .3s, box-shadow .3s; display: flex; flex-direction: column;
  }
  .home-blog-card:hover { transform: translateY(-5px); border-color: var(--pink); box-shadow: 0 15px 40px rgba(0,0,62,.06); }
  .home-blog-image { height: 220px; overflow: hidden; position: relative; }
  .home-blog-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .home-blog-card:hover .home-blog-image img { transform: scale(1.05); }
  .home-blog-cat {
    position: absolute; bottom: 1rem; left: 1rem;
    background: rgba(0,0,62,.85); backdrop-filter: blur(8px);
    color: white; font-family: var(--font-body); font-size: .65rem;
    letter-spacing: .08em; text-transform: uppercase;
    padding: .3rem .7rem; border-radius: 100px;
  }
  .home-blog-content { padding: 1.8rem; display: flex; flex-direction: column; flex-grow: 1; }
  .home-blog-date { font-family: var(--font-body); font-size: .7rem; color: var(--muted); margin-bottom: .6rem; }
  .home-blog-content h3 { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 600; line-height: 1.35; margin: 0 0 1.2rem; flex-grow: 1; }
  .home-blog-read {
    font-family: var(--font-body); font-size: .72rem; letter-spacing: .08em;
    text-transform: uppercase; color: var(--pink);
  }

  /* =================== CONTACT =================== */
  .contact-section { padding-bottom: 10rem; padding-top: 10rem; }
  .contact-section h2 { font-size: clamp(4rem, 10vw, 10rem); }
  .contact-email { color: var(--caramel); display: inline-block; font-size: clamp(1.5rem, 3vw, 3rem); font-family: var(--font-heading); font-weight: 500; text-decoration: none; transition: color .2s; }
  .contact-email:hover { color: var(--paper); }
  .contact-meta { border-top: 1px solid rgba(63,154,230,.5); display: flex; justify-content: space-between; margin-top: 7rem; padding-top: 1.5rem; }
  .contact-meta a, .contact-meta span { color: var(--paper); font-family: var(--font-body); font-size: .75rem; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }

  /* =================== RESPONSIVE =================== */
  @media (max-width: 960px) {
    .home-blog-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .hero-section, .proof-section, .statement-grid, .case-grid, .careers-teaser-grid { display: block; }
    .hero-section { padding: 130px 20px 70px; }
    .hero-visual { margin: 3rem 0 0 5vw; min-height: 430px; }
    .hero-scroll { bottom: 1.5rem; left: 20px; }
    .statement-section, .services-section, .case-section, .approach-section, .careers-teaser-section, .home-blog-section, .contact-section { padding: 5rem 20px; }
    .statement-grid h2, .case-grid h2, .careers-teaser-grid h2 { margin-top: 3rem; }
    .section-heading { display: block; }
    .section-heading h2 { margin-top: 3rem; }
    .service-list, .approach-grid { margin-top: 4rem; }
    .service-row { gap: .7rem; grid-template-columns: 2.5rem 1fr 1.5rem; }
    .service-row p { display: none; }
    .proof-image, .case-image { min-height: 420px; }
    .proof-copy { padding: 5rem 20px; }
    .approach-grid { grid-template-columns: 1fr 1fr; }
    .approach-grid article:nth-child(2) { border-right: 0; }
    .approach-grid article:nth-child(3), .approach-grid article:nth-child(4) { border-top: 1px solid var(--line); }
    .stats-section { padding: 4rem 20px; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
    .home-blog-grid { grid-template-columns: 1fr; }
  }
</style>