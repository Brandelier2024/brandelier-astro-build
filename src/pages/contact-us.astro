---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Contact Digital Marketing Company in Pune | Brandelier" description="Contact Brandelier – a creative digital marketing company in Pune. Reach us for SEO, branding, social media & web solutions.">

  <PageHero
    title="Let's talk"
    highlight="business."
    description="Have a project in mind? We'd love to hear from you. Reach out and let's start building something extraordinary."
    breadcrumb={[{ label: 'Contact Us', href: '/contact-us' }]}
  />

  <section class="contact-main">
    <div class="contact-grid">
      <!-- Contact Form -->
      <div class="contact-form-wrap">
        <h2>Send us a message</h2>
        <form
          class="contact-form"
          id="contact-form"
          data-ajax-url="https://cms.brandelier.in/wp-json/brandelier/v1/contact"
          novalidate
        >
          <div class="form-row">
            <div class="form-group">
              <label for="name">Full Name <span class="required-star">*</span></label>
              <input type="text" id="name" name="name" placeholder="Your name" required autocomplete="name" />
              <span class="field-error" id="error-name"></span>
            </div>
            <div class="form-group">
              <label for="email">Email Address <span class="required-star">*</span></label>
              <input type="email" id="email" name="email" placeholder="you@company.com" required autocomplete="email" />
              <span class="field-error" id="error-email"></span>
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="+91 XXXXX XXXXX" autocomplete="tel" />
              <span class="field-error" id="error-phone"></span>
            </div>
            <div class="form-group">
              <label for="service">Service Interested In</label>
              <div class="select-wrapper">
                <select id="service" name="service">
                  <option value="">Select a service</option>
                  <option value="Social Media Marketing">Social Media Marketing</option>
                  <option value="Web Development">Web Development</option>
                  <option value="SEO Optimization">SEO Optimization</option>
                  <option value="Videography & Photography">Videography & Photography</option>
                  <option value="Content Marketing">Content Marketing</option>
                  <option value="Brand Design">Brand Design</option>
                </select>
              </div>
            </div>
          </div>

          <div class="form-group message-group">
            <label for="message">Your Message <span class="required-star">*</span></label>
            <textarea id="message" name="message" rows="5" placeholder="Tell us about your brand, goals, or timeline..." required></textarea>
            <span class="field-error" id="error-message"></span>
          </div>

          <!-- Anti-bot honeypot field -->
          <div style="display:none!important; position:absolute; left:-9999px;" aria-hidden="true">
            <input type="text" name="brandelier_hp_catch" tabindex="-1" autocomplete="off" />
          </div>

          <!-- Security anti-tamper token -->
          <input type="hidden" name="form_token" value="bnd_form_9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d" />

          <button type="submit" class="submit-btn" id="contactSubmitBtn">
            <span class="btn-text">Send Message <span aria-hidden="true">↗</span></span>
            <span class="btn-loading" style="display:none;">
              <span class="spinner"></span> Sending...
            </span>
          </button>

          <div class="form-status" id="formStatus" style="display:none;" role="alert"></div>
        </form>
      </div>

      <!-- Contact Info Sidebar -->
      <div class="contact-info">
        <div class="info-card">
          <h3>Get in Touch</h3>
          <div class="info-item">
            <span class="info-label">Email</span>
            <a href="mailto:Info@brandelier.in">Info@brandelier.in</a>
          </div>
          <div class="info-item">
            <span class="info-label">Phone</span>
            <a href="tel:+917058670837">+91 70586 70837</a>
          </div>
          <div class="info-item">
            <span class="info-label">Office Hours</span>
            <span>Mon – Fri, 10:00 AM – 6:00 PM</span>
          </div>
        </div>

        <div class="info-card">
          <h3>Visit Us</h3>
          <p class="address">
            Sr No. 92, Sunset Avenue, Office No – 104,<br />
            1st Floor, Pancard Club Rd, Pune,<br />
            Maharashtra – 411069, India
          </p>
        </div>

        <div class="info-card">
          <h3>Follow Us</h3>
          <div class="social-links">
            <a href="https://www.instagram.com/brandelier.in/?hl=en" target="_blank" rel="noopener">Instagram ↗</a>
            <a href="https://www.linkedin.com/company/brandelier-in/" target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href="https://www.facebook.com/brandelier" target="_blank" rel="noopener">Facebook ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="map-section">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3782.0!2d73.8!3d18.56!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sAundh%2C+Pune!5e0!3m2!1sen!2sin!4v1"
      width="100%"
      height="450"
      style="border:0; display:block;"
      allowfullscreen=""
      loading="lazy"
      title="Brandelier Office Location"
    ></iframe>
  </section>
</Layout>

<style>
  h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -.04em;
    margin: 0 0 2rem;
  }
  h2 em {
    color: var(--pink);
    font-style: normal;
  }

  .contact-main {
    padding: 6rem 10vw;
    width: 100%;
    box-sizing: border-box;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 5rem;
    align-items: start;
    width: 100%;
  }

  /* Form */
  .contact-form {
    width: 100%;
    box-sizing: border-box;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    width: 100%;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    box-sizing: border-box;
  }
  .message-group {
    margin-bottom: 1.5rem;
  }
  .form-group label {
    display: block;
    font-family: var(--font-body);
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: .6rem;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    font-family: var(--font-body);
    font-size: 1rem; /* 16px to prevent iOS Safari auto-zoom */
    color: var(--ink);
    background: white;
    transition: border-color .25s ease, box-shadow .25s ease;
    outline: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--pink);
    box-shadow: 0 0 0 3px rgba(221,46,184,.12);
  }
  .select-wrapper {
    position: relative;
    width: 100%;
  }
  .select-wrapper::after {
    content: '↓';
    position: absolute;
    right: 1.2rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    font-size: .8rem;
    color: var(--muted);
  }
  .form-group select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    padding-right: 2.5rem;
  }
  .form-group textarea {
    resize: vertical;
    min-height: 130px;
    line-height: 1.5;
  }

  .required-star {
    color: var(--pink);
  }

  .field-error {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: #e53e3e;
    margin-top: 0.4rem;
    min-height: 1rem;
  }

  .input-error {
    border-color: #e53e3e !important;
    background-color: rgba(229, 62, 62, 0.03) !important;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-family: var(--font-body);
    font-size: .78rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--paper);
    border: none;
    padding: 1.2rem 2.5rem;
    cursor: pointer;
    border-radius: 100px;
    transition: background .3s ease, transform .2s ease;
  }
  .submit-btn:hover:not(:disabled) {
    background: var(--pink);
    transform: translateY(-2px);
  }
  .submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }

  .btn-loading {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: #fff;
    animation: spin 0.7s linear infinite;
    display: inline-block;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Status Message */
  .form-status {
    margin-top: 1.5rem;
    padding: 1.2rem 1.4rem;
    border-radius: 12px;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.5;
    animation: fadeIn 0.3s ease-out;
  }
  .form-status.success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #15803d;
  }
  .form-status.error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #b91c1c;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Info Sidebar */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    width: 100%;
    box-sizing: border-box;
  }
  .info-card {
    padding: 2.2rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: white;
    transition: border-color .3s ease, box-shadow .3s ease;
    box-sizing: border-box;
    width: 100%;
  }
  .info-card:hover {
    border-color: var(--pink);
    box-shadow: 0 10px 30px rgba(0,0,62,.04);
  }
  .info-card h3 {
    font-family: var(--font-heading);
    font-size: .7rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--blue-bell);
    margin: 0 0 1.5rem;
  }
  .info-item {
    margin-bottom: 1.25rem;
  }
  .info-item:last-child {
    margin-bottom: 0;
  }
  .info-label {
    display: block;
    font-family: var(--font-body);
    font-size: .65rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(0,0,62,.4);
    margin-bottom: .3rem;
  }
  .info-item a,
  .info-item span {
    font-family: var(--font-body);
    font-size: .88rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.5;
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  .info-item a:hover {
    color: var(--pink);
  }
  .address {
    font-family: var(--font-body);
    font-size: .88rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
    word-break: break-word;
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
  }
  .social-links a {
    font-family: var(--font-body);
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: .5rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 100px;
    transition: all .25s ease;
    white-space: nowrap;
  }
  .social-links a:hover {
    border-color: var(--pink);
    color: var(--pink);
  }

  .map-section {
    background: var(--ink);
    width: 100%;
    overflow: hidden;
  }

  /* Responsive Breakpoints */
  @media (max-width: 900px) {
    .contact-main {
      padding: 4.5rem 5vw;
    }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 600px) {
    .contact-main {
      padding: 3.5rem 1.25rem 4.5rem;
    }
    .contact-grid {
      gap: 3rem;
    }
    .form-row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-bottom: 1.25rem;
    }
    .submit-btn {
      width: 100%;
      justify-content: center;
      padding: 1.15rem;
    }
    .info-card {
      padding: 1.5rem 1.25rem;
    }
    .social-links a {
      flex: 1 1 auto;
      text-align: center;
    }
    .map-section iframe {
      height: 320px;
    }
  }
</style>

<script>
  // ============================================================
  //  Contact Us Form Handler (Elementor Pro & Email Gateway)
  // ============================================================
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusBox = document.getElementById('formStatus') as HTMLDivElement | null;
  const submitBtn = document.getElementById('contactSubmitBtn') as HTMLButtonElement | null;

  function clearErrors() {
    document.querySelectorAll('.field-error').forEach((el) => {
      (el as HTMLElement).textContent = '';
    });
    document.querySelectorAll('#contact-form input, #contact-form textarea, #contact-form select').forEach((el) => {
      el.classList.remove('input-error');
    });
  }

  function setFieldError(errorId: string, message: string, inputEl?: HTMLElement | null) {
    const errEl = document.getElementById(errorId);
    if (errEl) errEl.textContent = message;
    if (inputEl) inputEl.classList.add('input-error');
  }

  function showStatus(type: 'success' | 'error', message: string) {
    if (!statusBox) return;
    statusBox.className = `form-status ${type}`;
    statusBox.textContent = message;
    statusBox.style.display = 'block';
    statusBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function validateForm(): boolean {
    clearErrors();
    let valid = true;

    const nameInput = document.getElementById('name') as HTMLInputElement | null;
    const emailInput = document.getElementById('email') as HTMLInputElement | null;
    const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;

    if (!nameInput?.value.trim()) {
      setFieldError('error-name', 'Please enter your full name', nameInput);
      valid = false;
    }

    if (!emailInput?.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
      setFieldError('error-email', 'Please enter a valid email address', emailInput);
      valid = false;
    }

    if (!messageInput?.value.trim()) {
      setFieldError('error-message', 'Please write your message', messageInput);
      valid = false;
    }

    return valid;
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateForm()) return;

      const ajaxUrl = form.dataset.ajaxUrl || 'https://cms.brandelier.in/wp-json/brandelier/v1/contact';
      const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement | null;
      const btnLoading = submitBtn?.querySelector('.btn-loading') as HTMLElement | null;

      // Loading state
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnLoading) btnLoading.style.display = 'inline-flex';
      if (statusBox) statusBox.style.display = 'none';

      const formData = new FormData(form);

      try {
        const response = await fetch(ajaxUrl, {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        let result: any = {};
        const contentType = response.headers.get('content-type') || '';
        if (contentType.includes('application/json')) {
          result = await response.json();
        } else {
          const text = await response.text();
          try { result = JSON.parse(text); } catch { result = { success: response.ok }; }
        }

        if (response.ok && (result.success !== false)) {
          showStatus('success', '🎉 Thank you for reaching out! Your message has been sent successfully. We will get back to you shortly.');
          form.reset();
        } else {
          const errorMsg = result?.message || result?.data?.message || 'Something went wrong. Please try again or reach out to us at Info@brandelier.in.';
          showStatus('error', `❌ ${errorMsg}`);
        }
      } catch (err) {
        showStatus('error', '❌ Network error connecting to server. Please try again or email us directly at Info@brandelier.in.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (btnLoading) btnLoading.style.display = 'none';
      }
    });
  }
</script>
