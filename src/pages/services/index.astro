---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

const servicesData = [
  {
    id: 'smm',
    number: '01',
    title: 'Social Media Marketing',
    href: '/services/social-media-marketing',
    category: 'Audience & Engagement',
    tagline: 'Turn digital attention into passionate brand advocacy and paying customers.',
    description: 'Build your brand voice, grow your audience, and drive real engagement across platforms. We manage your social presence with strategic content, community management, and targeted campaigns.',
    features: ['Platform Strategy', 'Content Calendars', 'Community Management', 'Paid Social Campaigns'],
    kpi: '+240% Average Engagement',
    metricLabel: 'Community Reach Growth',
    targetId: 'service-card-01'
  },
  {
    id: 'webdev',
    number: '02',
    title: 'Web Development',
    href: '/services/web-development',
    category: 'Architecture & UI/UX',
    tagline: 'High-speed, conversion-engineered digital flagships crafted to scale.',
    description: 'We build more than websites — we craft seamless digital journeys. Our web development services help brands convert, connect, and grow with beautiful, high-performance sites.',
    features: ['Custom Websites', 'E-commerce Solutions', 'High-Converting Landing Pages', 'Bespoke UI/UX Design'],
    kpi: '< 0.8s Ultra-Fast Load Speed',
    metricLabel: 'Conversion Boost Rate',
    targetId: 'service-card-02'
  },
  {
    id: 'seo',
    number: '03',
    title: 'SEO Optimization',
    href: '/services/seo-optimization',
    category: 'Organic Dominance',
    tagline: 'Claim dominant organic search real estate right where your high-intent buyers search.',
    description: 'Dominate search rankings with data-driven SEO strategies. We optimize your digital presence to drive organic traffic, increase visibility, and generate quality leads.',
    features: ['On-page & Off-page SEO', 'Technical Audits', 'Authority Link Building', 'Local Pune & Pan-India SEO'],
    kpi: 'Top 3 Organic Placements',
    metricLabel: 'Consistent Qualified Leads',
    targetId: 'service-card-03'
  },
  {
    id: 'video',
    number: '04',
    title: 'Videography & Photography',
    href: '/services/videography-photography',
    category: 'Visual Storytelling',
    tagline: 'Cinematic visual production that halts the scroll and etches your brand into memory.',
    description: 'Visual storytelling that captures your brand essence. From product shoots to cinematic brand films, we produce content that makes audiences stop, watch, and remember.',
    features: ['Cinematic Brand Films', 'Studio Product Photography', 'Viral High-Energy Reels', 'Corporate & Event Coverage'],
    kpi: '4K Cinema Standard',
    metricLabel: 'High View-Through Rate',
    targetId: 'service-card-04'
  },
  {
    id: 'content',
    number: '05',
    title: 'Content Marketing',
    href: '/services/content-marketing',
    category: 'Thought Leadership',
    tagline: 'Strategic content engines that educate, convert, and nurture lifelong customer relationships.',
    description: 'Stories, systems, and useful content that keep your brand in motion. We create and distribute compelling content that educates, entertains, and converts your audience.',
    features: ['SEO Editorial & Blog Writing', 'Conversion Copywriting', 'Automated Email Systems', 'Omnichannel Content Strategy'],
    kpi: '3.8x Lead Velocity',
    metricLabel: 'Sustainable Inbound ROI',
    targetId: 'service-card-05'
  },
  {
    id: 'branding',
    number: '06',
    title: 'Brand Design',
    href: '/services/brand-design',
    category: 'Brand Systems & Design',
    tagline: 'Timeless visual identity systems that position you as the undeniable market leader.',
    description: 'Create a powerful visual identity that resonates with your audience. From logos to complete brand guidelines, we design identities that stand the test of time.',
    features: ['Iconic Logo Design', 'Comprehensive Brand Guidelines', 'Premium Packaging Design', 'Complete Visual Design Systems'],
    kpi: '100% Bespoke Identity',
    metricLabel: 'High Brand Recall Value',
    targetId: 'service-card-06'
  },
];

const faqs = [
  {
    num: '01',
    question: 'How do you determine which digital marketing services are right for our brand?',
    answer: 'Every collaboration begins with our deep-dive Discovery Audit. We analyze your market positioning, competitor benchmarks, current customer journey, and growth targets. Rather than selling generic packages, we architect a custom multichannel roadmap aligned directly with your revenue goals.'
  },
  {
    num: '02',
    question: 'Can we bundle multiple core services like Web Development, SEO, and Social Media?',
    answer: 'Yes! In fact, integrated multichannel execution delivers the highest compound ROI. When your high-speed website is architected with technical SEO in mind and continuously fed with cinematic visual content and social media traffic, every marketing rupee works exponentially harder.'
  },
  {
    num: '03',
    question: 'What sets Brandelier’s videography and photography apart from standard studios?',
    answer: 'We don’t just shoot pretty frames — we produce story-driven content built for modern platform algorithms. From studio lighting setups to cinematic camera gear, every reel, product photo, and brand documentary is engineered for retention, scroll-stopping visual impact, and conversion.'
  },
  {
    num: '04',
    question: 'How do you track performance and communicate campaign ROI?',
    answer: 'Transparency is fundamental to our agency ethos. We track key performance indicators (KPIs) through live analytics dashboards and deliver monthly strategic reviews covering traffic growth, customer acquisition costs, lead volume, and engagement metrics.'
  }
];
---

<Layout title="Top Digital Marketing Services in Pune | Brandelier" description="Grow your brand with expert digital marketing services in Pune by Brandelier – from SEO to content, branding, web development, and social media strategies.">

  <PageHero
    title="Strategy meets"
    highlight="execution."
    description="We offer end-to-end digital marketing services designed to help brands grow, connect, and dominate their space."
    breadcrumb={[{ label: 'Services', href: '/services' }]}
  />

  <!-- ========================================================
       INTERACTIVE ANIMATED SERVICE EXPLORER DROPDOWN SECTION
       ======================================================== -->
  <section class="interactive-service-explorer">
    <div class="explorer-header">
      <div class="explorer-badge-row">
        <span class="pulse-beacon"></span>
        <span class="explorer-badge">Interactive Capability Explorer</span>
      </div>
      <h2>Select a service.<br /><em>Inspect deliverables in real-time.</em></h2>
      <p class="explorer-sub">
        Click the animated dropdown below to switch between Brandelier’s core disciplines and inspect technical scopes, deliverables, and performance outcomes.
      </p>
    </div>

    <div class="dropdown-explorer-widget">
      <!-- Interactive Dropdown Button & Flyout -->
      <div class="explorer-dropdown-container" id="explorerDropdownContainer">
        <button
          class="explorer-dropdown-btn"
          id="explorerDropdownBtn"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <div class="btn-selected-content">
            <span class="btn-glow-dot"></span>
            <span class="btn-service-num" id="dropdownSelectedNum">01</span>
            <span class="btn-service-title" id="dropdownSelectedTitle">Social Media Marketing</span>
          </div>
          <div class="btn-action-hint">
            <span class="hint-text">Choose Discipline</span>
            <svg class="dropdown-chevron-svg" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M4 6L8 10L12 6" />
            </svg>
          </div>
        </button>

        <!-- Dropdown Menu List -->
        <div class="explorer-dropdown-list" id="explorerDropdownList" role="listbox">
          {servicesData.map((s, idx) => (
            <div
              class:list={['explorer-dropdown-item', { selected: idx === 0 }]}
              role="option"
              data-index={idx}
              data-id={s.id}
            >
              <div class="item-left">
                <span class="item-num">{s.number}</span>
                <div class="item-meta">
                  <span class="item-title">{s.title}</span>
                  <span class="item-cat">{s.category}</span>
                </div>
              </div>
              <span class="item-check">✓</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Live Animated Spotlight Showcase Card -->
      <div class="explorer-spotlight-card" id="explorerSpotlight">
        <div class="spotlight-glass">
          <div class="spotlight-top">
            <div class="spotlight-num-badge" id="spotlightNum">01</div>
            <span class="spotlight-category" id="spotlightCat">Audience & Engagement</span>
            <div class="spotlight-metric">
              <span class="metric-val" id="spotlightMetricVal">+240% Average Engagement</span>
              <span class="metric-sub" id="spotlightMetricLabel">Community Reach Growth</span>
            </div>
          </div>

          <div class="spotlight-body">
            <h3 class="spotlight-title" id="spotlightTitle">Social Media Marketing</h3>
            <p class="spotlight-tagline" id="spotlightTagline">Turn digital attention into passionate brand advocacy and paying customers.</p>
            <p class="spotlight-desc" id="spotlightDesc">Build your brand voice, grow your audience, and drive real engagement across platforms. We manage your social presence with strategic content, community management, and targeted campaigns.</p>
            
            <div class="spotlight-features-wrap">
              <span class="features-label">Core Deliverables:</span>
              <div class="spotlight-features" id="spotlightFeatures">
                <span class="feature-chip">✓ Platform Strategy</span>
                <span class="feature-chip">✓ Content Calendars</span>
                <span class="feature-chip">✓ Community Management</span>
                <span class="feature-chip">✓ Paid Social Campaigns</span>
              </div>
            </div>
          </div>

          <div class="spotlight-footer">
            <a href="/services/social-media-marketing" class="spotlight-action-btn" id="spotlightActionBtn">
              Explore Full Service Page <span aria-hidden="true">↗</span>
            </a>
            <button class="spotlight-jump-btn" id="spotlightJumpBtn" type="button" data-target="service-card-01">
              Scroll to Grid Card ↓
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       FULL SERVICES GRID
       ======================================================== -->
  <section class="services-listing" id="services-grid-anchor">
    {servicesData.map(service => (
      <a href={service.href} class="service-card-link" id={service.targetId}>
        <article class="service-card">
          <div class="service-card-top">
            <span class="service-num">{service.number}</span>
            <span class="service-arrow">↗</span>
          </div>
          <h2>{service.title}</h2>
          <p class="service-desc">{service.description}</p>
          <div class="service-features">
            {service.features.map(f => (
              <span class="feature-tag">{f}</span>
            ))}
          </div>
        </article>
      </a>
    ))}
  </section>

  <!-- ========================================================
       PROCESS SECTION
       ======================================================== -->
  <section class="process-section">
    <div class="process-heading">
      <p class="section-label">Our Process</p>
      <h2>Good work,<br /><em>on purpose.</em></h2>
    </div>
    <div class="process-grid">
      <article class="process-step">
        <span class="process-num">01</span>
        <h3>Discovery & Strategy</h3>
        <p>We dive deep into your business, market, and audience to craft a data-backed digital strategy.</p>
      </article>
      <article class="process-step">
        <span class="process-num">02</span>
        <h3>Design & Development</h3>
        <p>Beautiful, functional digital experiences that turn heads and drive conversions.</p>
      </article>
      <article class="process-step">
        <span class="process-num">03</span>
        <h3>Marketing & Promotion</h3>
        <p>Cross-platform campaigns that build awareness, generate leads, and drive results.</p>
      </article>
      <article class="process-step">
        <span class="process-num">04</span>
        <h3>Monitoring & Optimization</h3>
        <p>Data-led refinement to continuously improve performance and ROI.</p>
      </article>
    </div>
  </section>

  <!-- ========================================================
       INTERACTIVE ANIMATED SERVICE SCOPE ACCORDION (FAQ)
       ======================================================== -->
  <section class="service-faq-section">
    <div class="faq-heading">
      <p class="section-label">Service Architecture</p>
      <h2>Frequently Asked<br /><em>Questions & Scope</em></h2>
      <p class="faq-sub">Common questions about our digital marketing, development, and branding processes.</p>
    </div>

    <div class="faq-accordion-container">
      {faqs.map(faq => (
        <div class="faq-accordion-item">
          <button class="faq-accordion-header" type="button" aria-expanded="false">
            <div class="faq-title-wrap">
              <span class="faq-index">{faq.num}</span>
              <span class="faq-question-text">{faq.question}</span>
            </div>
            <div class="faq-icon-pill">
              <svg class="faq-chevron-svg" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M4 6L8 10L12 6" />
              </svg>
            </div>
          </button>
          <div class="faq-accordion-body">
            <div class="faq-body-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="services-cta">
    <p class="section-label">Let's work together</p>
    <h2>Have a project<br /><em>in mind?</em></h2>
    <a href="/contact-us" class="cta-button">Start a Conversation <span aria-hidden="true">↗</span></a>
  </section>

</Layout>

<script define:vars={{ servicesData }}>
  // ========================================================
  // INTERACTIVE SERVICE EXPLORER DROPDOWN LOGIC
  // ========================================================
  const dropdownContainer = document.getElementById('explorerDropdownContainer');
  const dropdownBtn = document.getElementById('explorerDropdownBtn');
  const dropdownList = document.getElementById('explorerDropdownList');
  const selectedNum = document.getElementById('dropdownSelectedNum');
  const selectedTitle = document.getElementById('dropdownSelectedTitle');

  const spotlightCard = document.getElementById('explorerSpotlight');
  const spotlightNum = document.getElementById('spotlightNum');
  const spotlightCat = document.getElementById('spotlightCat');
  const spotlightMetricVal = document.getElementById('spotlightMetricVal');
  const spotlightMetricLabel = document.getElementById('spotlightMetricLabel');
  const spotlightTitle = document.getElementById('spotlightTitle');
  const spotlightTagline = document.getElementById('spotlightTagline');
  const spotlightDesc = document.getElementById('spotlightDesc');
  const spotlightFeatures = document.getElementById('spotlightFeatures');
  const spotlightActionBtn = document.getElementById('spotlightActionBtn');
  const spotlightJumpBtn = document.getElementById('spotlightJumpBtn');

  // Toggle dropdown open/close
  if (dropdownBtn && dropdownContainer) {
    dropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = dropdownContainer.classList.contains('open');
      dropdownContainer.classList.toggle('open', !isOpen);
      dropdownBtn.setAttribute('aria-expanded', String(!isOpen));
    });
  }

  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (dropdownContainer && !dropdownContainer.contains(e.target)) {
      dropdownContainer.classList.remove('open');
      dropdownBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // Select item from dropdown
  const dropdownItems = document.querySelectorAll('.explorer-dropdown-item');
  dropdownItems.forEach((item) => {
    item.addEventListener('click', () => {
      const index = parseInt(item.getAttribute('data-index') || '0', 10);
      const data = servicesData[index];
      if (!data) return;

      // Update dropdown selected button
      dropdownItems.forEach((it) => it.classList.remove('selected'));
      item.classList.add('selected');
      if (selectedNum) selectedNum.textContent = data.number;
      if (selectedTitle) selectedTitle.textContent = data.title;

      // Close dropdown
      dropdownContainer?.classList.remove('open');
      dropdownBtn?.setAttribute('aria-expanded', 'false');

      // Trigger interactive animation on spotlight card
      if (spotlightCard) {
        spotlightCard.classList.remove('spotlight-animate');
        void spotlightCard.offsetWidth; // Force reflow
        spotlightCard.classList.add('spotlight-animate');

        // Update spotlight contents
        if (spotlightNum) spotlightNum.textContent = data.number;
        if (spotlightCat) spotlightCat.textContent = data.category;
        if (spotlightMetricVal) spotlightMetricVal.textContent = data.kpi;
        if (spotlightMetricLabel) spotlightMetricLabel.textContent = data.metricLabel;
        if (spotlightTitle) spotlightTitle.textContent = data.title;
        if (spotlightTagline) spotlightTagline.textContent = data.tagline;
        if (spotlightDesc) spotlightDesc.textContent = data.description;
        if (spotlightActionBtn) {
          spotlightActionBtn.setAttribute('href', data.href);
          spotlightActionBtn.innerHTML = `Explore ${data.title} Page <span aria-hidden="true">↗</span>`;
        }
        if (spotlightJumpBtn) {
          spotlightJumpBtn.setAttribute('data-target', data.targetId);
        }

        // Render features
        if (spotlightFeatures) {
          spotlightFeatures.innerHTML = data.features
            .map((f) => `<span class="feature-chip">✓ ${f}</span>`)
            .join('');
        }
      }
    });
  });

  // Jump button smooth scroll
  if (spotlightJumpBtn) {
    spotlightJumpBtn.addEventListener('click', () => {
      const targetId = spotlightJumpBtn.getAttribute('data-target');
      if (targetId) {
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetEl.classList.add('card-highlight-pulse');
          setTimeout(() => {
            targetEl.classList.remove('card-highlight-pulse');
          }, 1800);
        }
      }
    });
  }

  // ========================================================
  // INTERACTIVE SERVICE FAQ ACCORDIONS
  // ========================================================
  const faqHeaders = document.querySelectorAll('.faq-accordion-header');
  faqHeaders.forEach((header) => {
    header.addEventListener('click', () => {
      const item = header.closest('.faq-accordion-item');
      if (!item) return;

      const isExpanded = header.getAttribute('aria-expanded') === 'true';
      header.setAttribute('aria-expanded', String(!isExpanded));
      item.classList.toggle('open', !isExpanded);
    });
  });
</script>

<style>
  .section-label { font-family: var(--font-body); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  h2 { font-family: var(--font-heading); font-size: clamp(2.8rem, 6vw, 5.5rem); font-weight: 500; letter-spacing: -.04em; line-height: .95; margin: 1.5rem 0 0; }
  h2 em { color: var(--pink); font-style: italic; }

  /* ========================================================
     INTERACTIVE ANIMATED SERVICE EXPLORER DROPDOWN STYLES
     ======================================================== */
  .interactive-service-explorer {
    padding: 6rem 10vw 4rem;
    background: linear-gradient(180deg, var(--paper) 0%, rgba(244,247,255,0.7) 100%);
    position: relative;
  }
  .explorer-header {
    max-width: 800px;
    margin-bottom: 3.5rem;
  }
  .explorer-badge-row {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 1.1rem;
    background: rgba(192, 44, 255, 0.08);
    border: 1px solid rgba(192, 44, 255, 0.25);
    border-radius: 100px;
  }
  .pulse-beacon {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 10px var(--pink);
    animation: beaconPulse 1.8s infinite;
  }
  @keyframes beaconPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }
  .explorer-badge {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--violet);
  }
  .explorer-sub {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted);
    margin-top: 1.2rem;
  }

  .dropdown-explorer-widget {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 1000px;
  }

  /* Interactive Dropdown Button Container */
  .explorer-dropdown-container {
    position: relative;
    width: 100%;
    z-index: 50;
  }
  .explorer-dropdown-btn {
    width: 100%;
    background: white;
    border: 2px solid rgba(0, 0, 62, 0.12);
    border-radius: 18px;
    padding: 1.25rem 1.8rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 62, 0.04);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }
  .explorer-dropdown-btn:hover {
    border-color: var(--pink);
    box-shadow: 0 12px 35px rgba(221, 46, 184, 0.12);
    transform: translateY(-2px);
  }
  .explorer-dropdown-container.open .explorer-dropdown-btn {
    border-color: var(--pink);
    box-shadow: 0 0 0 4px rgba(221, 46, 184, 0.15);
    border-radius: 18px 18px 8px 8px;
  }

  .btn-selected-content {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .btn-glow-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 10px var(--pink);
  }
  .btn-service-num {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--blue-bell);
    letter-spacing: 0.05em;
  }
  .btn-service-title {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    font-weight: 600;
    color: var(--ink);
  }

  .btn-action-hint {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--muted);
  }
  .hint-text {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .dropdown-chevron-svg {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .explorer-dropdown-container.open .dropdown-chevron-svg {
    transform: rotate(180deg);
    color: var(--pink);
  }

  /* Animated Dropdown Menu List */
  .explorer-dropdown-list {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 2px solid rgba(221, 46, 184, 0.3);
    border-radius: 8px 8px 18px 18px;
    padding: 0.6rem;
    box-shadow: 0 25px 60px rgba(0, 0, 62, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.99);
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 60;
  }
  .explorer-dropdown-container.open .explorer-dropdown-list {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .explorer-dropdown-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.4rem;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }
  .explorer-dropdown-item:hover {
    background: rgba(192, 44, 255, 0.08);
    border-color: rgba(192, 44, 255, 0.2);
    transform: translateX(4px);
  }
  .explorer-dropdown-item.selected {
    background: rgba(221, 46, 184, 0.1);
    border-color: rgba(221, 46, 184, 0.3);
  }

  .item-left {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .item-num {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--pink);
  }
  .item-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .item-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }
  .item-cat {
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .item-check {
    font-size: 1.1rem;
    color: var(--pink);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .explorer-dropdown-item.selected .item-check {
    opacity: 1;
  }

  /* Spotlight Card Display */
  .explorer-spotlight-card {
    border-radius: 24px;
    background: white;
    border: 1px solid var(--line);
