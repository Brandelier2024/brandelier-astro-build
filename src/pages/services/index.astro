---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getPosts } from '../../lib/wp';

const servicesData = [
  {
    id: 'smm',
    number: '01',
    title: 'Social Media Marketing',
    href: '/services/social-media-marketing',
    category: 'Audience & Engagement',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/WhatsApp-Image-2026-08-25-at-2.02.42-AM.jpeg',
    tagline: 'Turn digital attention into passionate brand advocacy and paying customers.',
    description: 'Build your brand voice, grow your audience, and drive real engagement across platforms. We manage your social presence with strategic content, community management, and targeted campaigns.',
    features: ['Platform Strategy', 'Content Calendars', 'Community Management', 'Paid Social Campaigns'],
    kpi: '+240% Average Engagement',
    metricLabel: 'Community Reach Growth',
    targetId: 'service-card-01'
  },
  {
    id: 'webdev',
    number: '02',
    title: 'Website Design & Development',
    href: '/services/web-development',
    category: 'Architecture & UI/UX',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/TAG@LENSSHIMMMER-08585-scaled.jpg',
    tagline: 'High-speed, conversion-engineered digital flagships crafted to scale.',
    description: 'We build more than websites — we craft seamless digital journeys. Our web development services help brands convert, connect, and grow with beautiful, high-performance sites.',
    features: ['Custom Websites', 'E-commerce Solutions', 'High-Converting Landing Pages', 'Bespoke UI/UX Design'],
    kpi: '< 0.8s Ultra-Fast Load Speed',
    metricLabel: 'Conversion Boost Rate',
    targetId: 'service-card-02'
  },
  {
    id: 'seo',
    number: '03',
    title: 'SEO Optimization',
    href: '/services/seo-optimization',
    category: 'Organic Dominance',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/TAG@LENSSHIMMMER-08596-scaled.jpg',
    tagline: 'Claim dominant organic search real estate right where your high-intent buyers search.',
    description: 'Dominate search rankings with data-driven SEO strategies. We optimize your digital presence to drive organic traffic, increase visibility, and generate quality leads.',
    features: ['On-page & Off-page SEO', 'Technical Audits', 'Authority Link Building', 'Local Pune & Pan-India SEO'],
    kpi: 'Top 3 Organic Placements',
    metricLabel: 'Consistent Qualified Leads',
    targetId: 'service-card-03'
  },
  {
    id: 'video',
    number: '04',
    title: 'Videography & Photography',
    href: '/services/videography-photography',
    category: 'Visual Storytelling',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/TAG@LENSSHIMMMER-00268-scaled.jpg',
    tagline: 'Cinematic visual production that halts the scroll and etches your brand into memory.',
    description: 'Visual storytelling that captures your brand essence. From product shoots to cinematic brand films, we produce content that makes audiences stop, watch, and remember.',
    features: ['Cinematic Brand Films', 'Studio Product Photography', 'Viral High-Energy Reels', 'Corporate & Event Coverage'],
    kpi: '4K Cinema Standard',
    metricLabel: 'High View-Through Rate',
    targetId: 'service-card-04'
  },
  {
    id: 'content',
    number: '05',
    title: 'Content Marketing',
    href: '/services/content-marketing',
    category: 'Thought Leadership',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/Brandelier-.jpg-scaled.jpeg',
    tagline: 'Strategic content engines that educate, convert, and nurture lifelong customer relationships.',
    description: 'Stories, systems, and useful content that keep your brand in motion. We create and distribute compelling content that educates, entertains, and converts your audience.',
    features: ['SEO Editorial & Blog Writing', 'Conversion Copywriting', 'Automated Email Systems', 'Omnichannel Content Strategy'],
    kpi: '3.8x Lead Velocity',
    metricLabel: 'Sustainable Inbound ROI',
    targetId: 'service-card-05'
  },
  {
    id: 'branding',
    number: '06',
    title: 'Branding & Design',
    href: '/services/brand-design',
    category: 'Brand Systems & Design',
    image: 'https://brandelier.in/wp-content/uploads/2026/08/Brandelier-3.jpg-scaled.jpeg',
    tagline: 'Timeless visual identity systems that position you as the undeniable market leader.',
    description: 'Create a powerful visual identity that resonates with your audience. From logos to complete brand guidelines, we design identities that stand the test of time.',
    features: ['Iconic Logo Design', 'Comprehensive Brand Guidelines', 'Premium Packaging Design', 'Complete Visual Design Systems'],
    kpi: '100% Bespoke Identity',
    metricLabel: 'High Brand Recall Value',
    targetId: 'service-card-06'
  },
];

const whyChooseUs = [
  {
    icon: '✦',
    title: 'Dedicated Team of Experts',
    desc: 'Specialized creators, strategists, designers, and developers working collaboratively on your brand.'
  },
  {
    icon: '◉',
    title: 'Transparent Pricing & Tracking',
    desc: 'Clear, milestone-based pricing with transparent reporting and live analytics tracking.'
  },
  {
    icon: '⬡',
    title: 'Data-Backed & Original Content',
    desc: 'High-performing strategies rooted in market analytics and 100% bespoke creative executions.'
  },
  {
    icon: '◈',
    title: 'Preferred Choice in Pune',
    desc: 'Trusted by 100+ ambitious businesses, startups, and established enterprises for measurable digital growth.'
  }
];

const faqs = [
  {
    num: '01',
    question: 'What makes Brandelier different from other marketing agencies in Pune?',
    answer: 'Brandelier stands out among marketing agencies for offering a creative blend of video production, design, and digital strategy. As a digital marketing services provider agency in Pune, we prioritize originality and performance.'
  },
  {
    num: '02',
    question: 'Do you offer both SEO and paid advertising?',
    answer: "Yes. We're recognized for our relevant SEO solutions for many of our clients and also manage high-performing Google Ads and Meta Ads campaigns."
  },
  {
    num: '03',
    question: 'Can I get a custom website design for my business?',
    answer: "Definitely. We’re a top-rated website designing company in Pune focused on building fast, user-friendly, and aesthetic websites tailored for your brand."
  },
  {
    num: '04',
    question: 'What kind of video production services do you provide?',
    answer: 'We offer everything from short reels, podcast production, and YouTube content to full-scale music video production—making us more than just a design agency.'
  },
  {
    num: '05',
    question: 'Are your services ideal for small and local businesses?',
    answer: 'Yes! As one of the most approachable digital marketing companies, we specialize in helping Pune-based startups and local businesses scale through personalized strategies.'
  },
  {
    num: '06',
    question: 'Do you provide social media marketing too?',
    answer: 'Of course. As a trusted social media marketing agency in Pune, we manage content, creatives, and campaigns for consistent brand engagement.'
  },
  {
    num: '07',
    question: 'How can I choose between SEO and paid marketing?',
    answer: "We’ll help you decide during a free consultation. Whether you’re looking for an SEO company in Pune or need help with comprehensive digital marketing services, we’ve got you covered."
  }
];

const allWpPosts = await getPosts();
const latestBlogs = allWpPosts.slice(0, 3);
---

<Layout 
  title="Top Digital Marketing Services in Pune | Brandelier" 
  description="Grow your brand with expert digital marketing services in Pune by Brandelier – from SEO to content, branding, web development, and social media strategies."
>

  <PageHero
    title="Strategy meets"
    highlight="execution."
    description="Brandelier provides digital marketing services in Pune that blend strategy, storytelling, and technology to bring your brand to life. From content to code, we’re here to elevate your digital identity."
    breadcrumb={[{ label: 'Services', href: '/services' }]}
  />

  <div class="services-page-wrapper">

    <!-- ========================================================
         INTERACTIVE ANIMATED SERVICE EXPLORER DROPDOWN SECTION
         ======================================================== -->
    <section class="interactive-service-explorer reveal-on-scroll">
      <div class="explorer-header">
        <div class="explorer-badge-row">
          <span class="pulse-beacon"></span>
          <span class="explorer-badge">Interactive Capability Explorer</span>
        </div>
        <h2>Select a service.<br /><em>Inspect deliverables in real-time.</em></h2>
        <p class="explorer-sub">
          Click the animated dropdown below to switch between Brandelier’s core disciplines and inspect technical scopes, deliverables, and performance outcomes.
        </p>
      </div>

      <div class="dropdown-explorer-widget">
        <!-- Interactive Dropdown Button & Flyout -->
        <div class="explorer-dropdown-container" id="explorerDropdownContainer">
          <button
            class="explorer-dropdown-btn"
            id="explorerDropdownBtn"
            type="button"
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <div class="btn-selected-content">
              <span class="btn-glow-dot"></span>
              <span class="btn-service-num" id="dropdownSelectedNum">01</span>
              <span class="btn-service-title" id="dropdownSelectedTitle">Social Media Marketing</span>
            </div>
            <div class="btn-action-hint">
              <span class="hint-text">Choose Discipline</span>
              <svg class="dropdown-chevron-svg" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M4 6L8 10L12 6" />
              </svg>
            </div>
          </button>

          <!-- Dropdown Menu List -->
          <div class="explorer-dropdown-list" id="explorerDropdownList" role="listbox">
            {servicesData.map((s, idx) => (
              <div
                class:list={['explorer-dropdown-item', { selected: idx === 0 }]}
                role="option"
                data-index={idx}
                data-id={s.id}
              >
                <div class="item-left">
                  <span class="item-num">{s.number}</span>
                  <div class="item-meta">
                    <span class="item-title">{s.title}</span>
                    <span class="item-cat">{s.category}</span>
                  </div>
                </div>
                <span class="item-check">✓</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Live Animated Spotlight Showcase Card -->
        <div class="explorer-spotlight-card" id="explorerSpotlight">
          <div class="spotlight-glass">
            <div class="spotlight-top">
              <div class="spotlight-num-badge" id="spotlightNum">01</div>
              <span class="spotlight-category" id="spotlightCat">Audience & Engagement</span>
              <div class="spotlight-metric">
                <span class="metric-val" id="spotlightMetricVal">+240% Average Engagement</span>
                <span class="metric-sub" id="spotlightMetricLabel">Community Reach Growth</span>
              </div>
            </div>

            <div class="spotlight-body">
              <h3 class="spotlight-title" id="spotlightTitle">Social Media Marketing</h3>
              <p class="spotlight-tagline" id="spotlightTagline">Turn digital attention into passionate brand advocacy and paying customers.</p>
              <p class="spotlight-desc" id="spotlightDesc">Build your brand voice, grow your audience, and drive real engagement across platforms. We manage your social presence with strategic content, community management, and targeted campaigns.</p>
              
              <div class="spotlight-features-wrap">
                <span class="features-label">Core Deliverables:</span>
                <div class="spotlight-features" id="spotlightFeatures">
                  <span class="feature-chip">✓ Platform Strategy</span>
                  <span class="feature-chip">✓ Content Calendars</span>
                  <span class="feature-chip">✓ Community Management</span>
                  <span class="feature-chip">✓ Paid Social Campaigns</span>
                </div>
              </div>
            </div>

            <div class="spotlight-footer">
              <a href="/services/social-media-marketing" class="spotlight-action-btn" id="spotlightActionBtn">
                Explore Full Service Page <span aria-hidden="true">↗</span>
              </a>
              <button class="spotlight-jump-btn" id="spotlightJumpBtn" type="button" data-target="service-card-01">
                Scroll to Grid Card ↓
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         FULL SERVICES GRID WITH IMAGE PLACEHOLDERS
         ======================================================== -->
    <section class="services-listing-section" id="services-grid-anchor">
      <div class="section-header-row reveal-on-scroll">
        <div>
          <p class="section-label">Capabilities</p>
          <h2>All Core <em>Services</em></h2>
        </div>
        <p class="section-subtitle">
          Comprehensive, high-impact digital solutions built for market leadership.
        </p>
      </div>

      <div class="services-listing">
        {servicesData.map(service => (
          <a href={service.href} class="service-card-link reveal-on-scroll" id={service.targetId}>
            <article class="service-card">
              <!-- Service Image Placeholder from brandelier.in -->
              <div class="service-card-image-box">
                <img 
                  src={service.image} 
                  alt={service.title} 
                  class="service-img-placeholder"
                  loading="lazy"
                />
                <div class="service-image-overlay">
                  <span class="service-num-badge">{service.number}</span>
                  <span class="service-category-badge">{service.category}</span>
                </div>
              </div>

              <div class="service-card-content">
                <div class="service-card-top">
                  <h3 class="service-card-title">{service.title}</h3>
                  <span class="service-arrow" aria-hidden="true">↗</span>
                </div>
                <p class="service-tagline-text">{service.tagline}</p>
                <p class="service-desc">{service.description}</p>
                
                <div class="service-features">
                  {service.features.map(f => (
                    <span class="feature-tag">✓ {f}</span>
                  ))}
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </section>

    <!-- ========================================================
         WHY CHOOSE US SECTION (Direct from brandelier.in)
         ======================================================== -->
    <section class="why-choose-section reveal-on-scroll">
      <div class="why-header">
        <p class="section-label">Our Edge</p>
        <h2>Why Choose <em>Us?</em></h2>
        <p class="why-sub">A creative powerhouse combining strategic data with world-class production.</p>
      </div>

      <div class="why-grid">
        {whyChooseUs.map(item => (
          <article class="why-card">
            <span class="why-icon">{item.icon}</span>
            <h3 class="why-card-title">{item.title}</h3>
            <p class="why-card-desc">{item.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ========================================================
         TRANSFORMATION VALUE BANNER
         ======================================================== -->
    <section class="transformation-banner reveal-on-scroll">
      <div class="banner-inner">
        <div class="banner-content">
          <span class="banner-badge">Pune's Premier Agency</span>
          <h2>Transform Your Business with <em>Brandelier!</em></h2>
          <p>
            From startups to established brands, businesses trust Brandelier when they search for the best SEO company, social media marketing companies, and innovative marketing agencies that go beyond the brief.
          </p>
        </div>
        <div class="banner-cta">
          <a href="/contact-us" class="banner-btn">Get In Touch <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <!-- ========================================================
         FREQUENTLY ASKED QUESTIONS (Accordion from brandelier.in)
         ======================================================== -->
    <section class="service-faq-section reveal-on-scroll">
      <div class="faq-heading">
        <p class="section-label">Questions & Clarifications</p>
        <h2>Frequently Asked <em>Questions</em></h2>
        <p class="faq-sub">Everything you need to know about partnering with Brandelier for your digital growth.</p>
      </div>

      <div class="faq-accordion-container">
        {faqs.map(faq => (
          <div class="faq-accordion-item">
            <button class="faq-accordion-header" type="button" aria-expanded="false">
              <div class="faq-title-wrap">
                <span class="faq-index">{faq.num}</span>
                <span class="faq-question-text">{faq.question}</span>
              </div>
              <div class="faq-icon-pill">
                <svg class="faq-chevron-svg" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M4 6L8 10L12 6" />
                </svg>
              </div>
            </button>
            <div class="faq-accordion-body">
              <div class="faq-body-content">
                <p>{faq.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ========================================================
         LATEST INSIGHTS & BLOGS WITH BRANDELIER IMAGE PLACEHOLDERS
         ======================================================== -->
    <section class="services-blogs-section reveal-on-scroll">
      <div class="section-header-row">
        <div>
          <p class="section-label">Knowledge & Growth</p>
          <h2>Latest <em>Blogs</em></h2>
        </div>
        <a href="/blog" class="view-all-blogs-link">Explore All Articles ↗</a>
      </div>

      <div class="blogs-grid">
        {latestBlogs.map(blog => (
          <article class="blog-card">
            <div class="blog-image-wrapper">
              <img 
                src={blog.image} 
                alt={blog.title} 
                class="service-img-placeholder"
                loading="lazy"
              />
              <span class="blog-category-tag">{blog.category}</span>
            </div>
            <div class="blog-info">
              <span class="blog-date">{blog.date}</span>
              <h3 class="blog-title"><a href={blog.href}>{blog.title}</a></h3>
              <a href={blog.href} class="blog-read-more">Read Insight <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ========================================================
         BOTTOM CTA SECTION (Standard Whole Site)
         ======================================================== -->
    <section class="services-cta-banner">
      <p class="section-label">Ready to scale?</p>
      <h2>Ready to grow your brand with one of the best<br /><em>digital marketing agencies in Pune?</em></h2>
      <p class="cta-sub">Let’s bring your ideas to life. Whether you need a full-stack marketing plan or just a new website, we’re ready to build, scale, and grow with you.</p>
      <a href="/contact-us" class="cta-button">Book Consultation <span aria-hidden="true">↗</span></a>
    </section>

  </div>
</Layout>

<style>
  /* ========================================================
     WHITE THEME DESIGN SYSTEM - SERVICES
     Consistent with entire Brandelier Rebuild Site
     ======================================================== */
  .services-page-wrapper {
    background: var(--paper);
    color: var(--ink);
    overflow-x: hidden;
  }

  .section-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  h2 {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 4.5vw, 4.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
    padding-bottom: 0.12em;
    overflow: visible;
    color: var(--ink);
    margin: 0;
  }

  h2 em {
    color: var(--pink);
    font-style: normal;
  }

  /* --------------------------------------------------------
     Animation utilities for inner pages
     -------------------------------------------------------- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-on-scroll.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* --------------------------------------------------------
     1. Interactive Service Explorer
     -------------------------------------------------------- */
  .interactive-service-explorer {
    padding: 6rem 10vw 4rem;
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
  }

  .explorer-header {
    max-width: 800px;
    margin-bottom: 3.5rem;
  }

  .explorer-badge-row {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(221, 46, 184, 0.08);
    border: 1px solid rgba(221, 46, 184, 0.25);
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 1.2rem;
  }

  .pulse-beacon {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 10px var(--pink);
    animation: beaconPulse 2s infinite ease-in-out;
  }

  @keyframes beaconPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .explorer-badge {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--pink);
  }

  .explorer-sub {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted);
    margin-top: 1rem;
  }

  .dropdown-explorer-widget {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 1100px;
  }

  .explorer-dropdown-container {
    position: relative;
    width: 100%;
    z-index: 50;
  }

  .explorer-dropdown-btn {
    width: 100%;
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 20px;
    padding: 1.3rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 62, 0.04);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .explorer-dropdown-btn:hover {
    border-color: var(--pink);
    box-shadow: 0 12px 35px rgba(221, 46, 184, 0.14);
    transform: translateY(-2px);
  }

  .btn-selected-content {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-glow-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 10px var(--pink);
  }

  .btn-service-num {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--blue-bell);
  }

  .btn-service-title {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 700;
    color: var(--ink);
  }

  .btn-action-hint {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--muted);
  }

  .hint-text {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .dropdown-chevron-svg {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .explorer-dropdown-container.open .dropdown-chevron-svg {
    transform: rotate(180deg);
    color: var(--pink);
  }

  .explorer-dropdown-list {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1.5px solid var(--pink);
    border-radius: 18px;
    padding: 0.6rem;
    box-shadow: 0 25px 60px rgba(0, 0, 62, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 60;
  }

  .explorer-dropdown-container.open .explorer-dropdown-list {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .explorer-dropdown-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.4rem;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .explorer-dropdown-item:hover,
  .explorer-dropdown-item.selected {
    background: rgba(221, 46, 184, 0.08);
  }

  .explorer-dropdown-item.selected .item-title,
  .explorer-dropdown-item:hover .item-title {
    color: var(--pink);
  }

  .item-left {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .item-num {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--blue-bell);
    font-size: 0.95rem;
  }

  .item-title {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--ink);
    font-size: 1.05rem;
  }

  .item-cat {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .item-check {
