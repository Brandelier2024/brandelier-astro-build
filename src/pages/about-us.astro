---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import PageHero from '../components/PageHero.astro';

const team = [
  { name: 'Gaurav Pawar', role: 'Co-Founder', desc: 'Visionary strategist driving brand growth and creative direction.' },
  { name: 'Rushikesh Patil', role: 'Co-Founder', desc: 'Leads operations and client partnerships with precision.' },
  { name: 'Roshan Bhise', role: 'Social Media Designer', desc: 'Creates scroll-stopping social media visuals and campaigns.' },
  { name: 'Rekha Kalje', role: 'Marketing Manager', desc: 'Drives marketing strategies and campaign performance.' },
  { name: 'Purushottam Raut', role: 'Graphic Designer', desc: 'Crafts compelling brand identities and visual assets.' },
  { name: 'Sudhanshu Sakhare', role: 'Web Developer', desc: 'Builds high-performance websites and digital experiences.' },
  { name: 'Shakti Kale', role: 'Content Head', desc: 'Shapes brand narratives and content strategy across platforms.' },
];

const values = [
  { icon: '✦', title: 'Innovation First', desc: 'We push boundaries to deliver creative solutions that stand apart.' },
  { icon: '◉', title: 'Client-Centric', desc: 'Your goals are our goals. We build lasting partnerships, not just projects.' },
  { icon: '⬡', title: 'Data-Driven', desc: 'Every decision is backed by insights, analytics, and performance data.' },
  { icon: '◈', title: 'Integrity', desc: 'Transparent communication and honest results — always.' },
];

const stats = [
  { number: '6+', label: 'Years of Experience' },
  { number: '100+', label: 'Happy Clients' },
  { number: '20+', label: 'Team Members' },
  { number: '500+', label: 'Projects Delivered' },
];
---

<Layout title="About Brandelier – A Creative Digital Marketing Agency in Pune" description="Learn more about Brandelier, a leading digital marketing agency in Pune offering SEO, branding, web design, and social media marketing services.">

  <PageHero
    title="We don't just market."
    highlight="We make brands matter."
    description="Brandelier Media Works is a full-service creative digital marketing agency in Pune. We exist to help ambitious brands make noise and mean more."
    breadcrumb={[{ label: 'About Us', href: '/about-us' }]}
  />

  <!-- Story Section -->
  <section class="story-section">
    <div class="story-grid">
      <div class="story-left">
        <p class="section-label">Our Story</p>
        <h2>Built on passion,<br /><em>driven by results.</em></h2>
      </div>
      <div class="story-right">
        <p class="story-text">What started as a shared passion for creativity and marketing has grown into one of Pune's most dynamic digital agencies. Founded by Gaurav Pawar and Rushikesh Patil, Brandelier was born from a simple belief: every brand deserves to be seen, heard, and remembered.</p>
        <p class="story-text">Over the past 6+ years, we've partnered with 100+ businesses — from ambitious startups to established enterprises — helping them craft compelling digital identities, execute high-impact campaigns, and achieve measurable growth.</p>
        <p class="story-text">Today, with a team of 20+ creative minds, we offer end-to-end digital marketing services including SEO, social media marketing, web development, content creation, videography, brand design, and performance marketing.</p>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="about-stats">
    <div class="about-stats-grid">
      {stats.map(stat => (
        <div class="about-stat">
          <span class="about-stat-num">{stat.number}</span>
          <span class="about-stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Image Break -->
  <section class="about-image-break">
    <Image src="https://brandelier.in/wp-content/uploads/2025/06/DSC09238-1024x769.webp" alt="Brandelier team at work" width={1600} height={900} loading="lazy" />
    <div class="image-overlay-text">
      <span>Where ideas</span>
      <span>become impact.</span>
    </div>
  </section>

  <!-- Values -->
  <section class="values-section">
    <div class="values-heading">
      <p class="section-label">Our Values</p>
      <h2>What guides<br /><em>everything we do.</em></h2>
    </div>
    <div class="values-grid">
      {values.map(v => (
        <article class="value-card">
          <span class="value-icon">{v.icon}</span>
          <h3>{v.title}</h3>
          <p>{v.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Team -->
  <section class="team-section">
    <div class="team-heading">
      <p class="section-label">Our Team</p>
      <h2>The people<br /><em>behind the brand.</em></h2>
    </div>
    <div class="team-grid">
      {team.map((member, i) => (
        <article class="team-card">
          <div class="team-avatar">
            <span>{member.name.split(' ').map(n => n[0]).join('')}</span>
          </div>
          <h3>{member.name}</h3>
          <p class="team-role">{member.role}</p>
          <p class="team-desc">{member.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <p class="section-label">Ready to grow?</p>
    <h2>Let's build something<br /><em>extraordinary.</em></h2>
    <a href="/contact-us" class="cta-button">Get in Touch <span aria-hidden="true">↗</span></a>
  </section>

</Layout>

<style>
  .section-label { font-family: var(--font-body); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  h2 { font-family: var(--font-heading); font-size: clamp(2.8rem, 6vw, 5.5rem); font-weight: 500; letter-spacing: -.04em; line-height: .95; margin: 1.5rem 0 0; }
  h2 em { color: var(--pink); font-style: normal; }

  /* Story */
  .story-section { padding: 8rem 10vw; }
  .story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; }
  .story-text { font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.6; color: var(--muted); margin: 0 0 1.5rem; }
  .story-text:last-child { margin-bottom: 0; }

  /* Stats */
  .about-stats { background: var(--ink); padding: 5rem 10vw; }
  .about-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; text-align: center; }
  .about-stat { padding: 2.5rem; border: 1px solid rgba(63,154,230,.15); border-radius: 16px; transition: border-color .3s, transform .3s; }
  .about-stat:hover { border-color: var(--pink); transform: translateY(-4px); }
  .about-stat-num { display: block; font-family: var(--font-heading); font-size: clamp(3rem, 5vw, 4.5rem); font-weight: 700; color: var(--paper); letter-spacing: -.04em; line-height: 1; margin-bottom: .5rem; }
  .about-stat-label { font-family: var(--font-body); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--blue-bell); }

  /* Image Break */
  .about-image-break { position: relative; height: 60vh; min-height: 400px; overflow: hidden; }
  .about-image-break img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.85); }
  .image-overlay-text { position: absolute; bottom: 3rem; left: 5vw; display: flex; flex-direction: column; }
  .image-overlay-text span { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 600; color: white; letter-spacing: -.04em; line-height: 1.1; text-shadow: 0 2px 20px rgba(0,0,0,.5); }
  .image-overlay-text span:last-child { font-style: normal; color: var(--caramel); }

  /* Values */
  .values-section { padding: 8rem 10vw; }
  .values-heading { margin-bottom: 5rem; }
  .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .value-card { padding: 2rem; border: 1px solid var(--line); border-radius: 16px; transition: border-color .3s, transform .3s; }
  .value-card:hover { border-color: var(--pink); transform: translateY(-4px); }
  .value-icon { display: block; font-size: 1.8rem; color: var(--pink); margin-bottom: 1.5rem; }
  .value-card h3 { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 600; margin: 0 0 .8rem; }
  .value-card p { font-family: var(--font-body); font-size: .88rem; line-height: 1.6; color: var(--muted); margin: 0; }

  /* Team */
  .team-section { background: var(--ink); color: var(--paper); padding: 8rem 10vw; }
  .team-section .section-label { color: var(--blue-bell); }
  .team-heading { margin-bottom: 5rem; }
  .team-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .team-card { text-align: center; padding: 2rem; border: 1px solid rgba(63,154,230,.1); border-radius: 16px; transition: border-color .3s, transform .3s; }
  .team-card:hover { border-color: var(--pink); transform: translateY(-4px); }
  .team-avatar { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, var(--violet), var(--pink)); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; }
  .team-avatar span { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: white; letter-spacing: .05em; }
  .team-card h3 { font-family: var(--font-heading); font-size: 1.2rem; font-weight: 600; margin: 0 0 .3rem; }
  .team-role { font-family: var(--font-body); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--caramel); margin: 0 0 1rem; }
  .team-desc { font-family: var(--font-body); font-size: .85rem; line-height: 1.55; color: rgba(244,247,255,.6); margin: 0; }

  /* CTA */
  .about-cta { background: var(--ink); color: var(--paper); padding: 8rem 10vw; border-top: 1px solid rgba(63,154,230,.15); text-align: center; }
  .about-cta .section-label { color: var(--blue-bell); }
  .cta-button { display: inline-flex; align-items: center; gap: 1rem; font-family: var(--font-body); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; color: var(--paper); border: 1px solid var(--blue-bell); padding: 1.2rem 2.5rem; margin-top: 3rem; transition: background .3s, border-color .3s; }
  .cta-button:hover { background: rgba(63,154,230,.15); border-color: var(--paper); }

  @media (max-width: 960px) {
    .team-grid, .values-grid { grid-template-columns: 1fr 1fr; }
    .about-stats-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .story-section, .values-section, .team-section, .about-cta { padding: 5rem 20px; }
    .story-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-stats { padding: 4rem 20px; }
    .team-grid, .values-grid { grid-template-columns: 1fr; }
  }
</style>
