---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const jobs = [
  {
    title: 'Videographer / Photographer',
    type: 'Full Time',
    location: 'Pune (On-site)',
    department: 'Production',
    experience: '1-3 Years',
    desc: 'We are seeking an eye for visual storytelling. You will lead on-location shoots, product photography, and create dynamic video assets for our growing portfolio of clients.',
    skills: ['Camera operation (Sony/Canon/Blackmagic)', 'Lighting & audio setup', 'Gimbal & drone operation', 'Basic color grading']
  },
  {
    title: 'Video Editor',
    type: 'Full Time',
    location: 'Pune (On-site)',
    department: 'Post-Production',
    experience: '1-3 Years',
    desc: 'Bring raw footage to life with rhythm, emotion, and technical finesse. You will edit reels, YouTube videos, and high-end brand commercials with motion graphics.',
    skills: ['Adobe Premiere Pro', 'After Effects', 'DaVinci Resolve', 'Sound design & pacing']
  },
  {
    title: 'Social Media Fulltime / Intern',
    type: 'Full Time / Internship',
    location: 'Pune (On-site / Hybrid)',
    department: 'Social Media',
    experience: '0-2 Years',
    desc: 'Live and breathe social algorithms. You will create daily content calendars, research trending audio, write witty hooks, and manage community interactions.',
    skills: ['Content calendar planning', 'Trend spotting & meme marketing', 'Instagram & LinkedIn growth', 'Copywriting & caption drafting']
  },
  {
    title: 'Graphic Designer',
    type: 'Full Time',
    location: 'Pune (On-site)',
    department: 'Creative Design',
    experience: '1-3 Years',
    desc: 'Craft stunning brand identities, marketing collateral, social carousel graphics, and campaign visuals that turn heads and build trust.',
    skills: ['Adobe Photoshop & Illustrator', 'Typography & layout design', 'Brand guideline creation', 'Figma']
  },
  {
    title: 'SEO Executive',
    type: 'Full Time',
    location: 'Pune (On-site)',
    department: 'Performance & SEO',
    experience: '1-3 Years',
    desc: 'Drive organic search dominance for our clients through on-page technical optimization, keyword gap research, backlink building, and Google Analytics tracking.',
    skills: ['Keyword research (Ahrefs/SEMrush)', 'Technical SEO audits', 'Google Search Console & GA4', 'On-page optimization']
  }
];

const perks = [
  { icon: '🚀', title: 'High-Impact Work', desc: 'Work directly on real-world brands across food & beverage, tech, real estate, and retail.' },
  { icon: '⚡', title: 'Creative Autonomy', desc: 'No micromanagement. Your bold ideas are encouraged, tested, and celebrated.' },
  { icon: '🌱', title: 'Accelerated Growth', desc: 'Learn directly alongside founders and seasoned industry veterans in a fast-paced environment.' },
  { icon: '☕', title: 'Great Culture & Coffee', desc: 'A vibrant studio environment in Pune equipped with modern gear and endless creative energy.' }
];
---

<Layout title="Careers at Brandelier – Join Our Creative Team in Pune" description="Explore job openings at Brandelier. We are hiring talented videographers, video editors, designers, social media managers, and SEO executives in Pune.">

  <PageHero
    title="Make work that"
    highlight="matters."
    description="Join a team of 20+ curious storytellers, designers, filmmakers, and digital strategists shaping the next generation of ambitious brands."
    breadcrumb={[{ label: 'Careers', href: '/careers' }]}
  />

  <!-- Culture Section -->
  <section class="careers-culture">
    <div class="culture-grid">
      <div class="culture-copy">
        <p class="section-label">Why Brandelier</p>
        <h2>Work where your craft<br /><em>is celebrated.</em></h2>
        <p class="body-text">We don't do boring routines. At Brandelier, every day brings a new creative challenge — from directing camera shoots at bustling cafes to optimizing multi-channel digital ad blitzes.</p>
        <p class="body-text">If you're eager to push your skills, obsess over the details, and make genuine impact, you'll feel right at home here.</p>
      </div>
      <div class="perks-grid">
        {perks.map(p => (
          <div class="perk-card">
            <span class="perk-icon">{p.icon}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Open Positions -->
  <section class="openings-section" id="openings">
    <div class="openings-heading">
      <p class="section-label">Current Openings</p>
      <h2>Find your<br /><em>next role.</em></h2>
    </div>

    <div class="jobs-list">
      {jobs.map(job => (
        <article class="job-card">
          <div class="job-header">
            <div>
              <div class="job-tags">
                <span class="tag-dept">{job.department}</span>
                <span class="tag-type">{job.type}</span>
                <span class="tag-loc">{job.location}</span>
              </div>
              <h3 class="job-title">{job.title}</h3>
            </div>
            <a href="mailto:Info@brandelier.in?subject=Application for ${job.title}" class="apply-btn">
              Apply Now ↗
            </a>
          </div>
          <p class="job-desc">{job.desc}</p>
          <div class="job-skills">
            <span class="skills-label">Key competencies:</span>
            {job.skills.map(s => (
              <span class="skill-chip">{s}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Speculative Application CTA -->
  <section class="speculative-cta">
    <p class="section-label">Don't see your exact role?</p>
    <h2>We're always looking for<br /><em>extraordinary talent.</em></h2>
    <p class="cta-copy">Send your portfolio, reel, or resume directly to our founders. Tell us how you'd like to collaborate.</p>
    <a href="mailto:Info@brandelier.in?subject=Spontaneous Application" class="cta-button">
      Send Your Portfolio ↗
    </a>
  </section>

</Layout>

<style>
  .section-label { font-family: var(--font-body); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  h2 { font-family: var(--font-heading); font-size: clamp(3rem, 6vw, 6rem); font-weight: 500; letter-spacing: -.06em; line-height: .88; margin: 1.5rem 0 0; }
  h2 em { color: var(--pink); font-style: italic; }

  /* Culture */
  .careers-culture { padding: 8rem 10vw; border-bottom: 1px solid var(--line); }
  .culture-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 6vw; align-items: start; }
  .body-text { font-size: 1.1rem; line-height: 1.6; color: var(--muted); margin-top: 1.5rem; }
  .perks-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .perk-card { padding: 2rem; border: 1px solid var(--line); border-radius: 16px; background: white; transition: transform .3s, border-color .3s; }
  .perk-card:hover { transform: translateY(-4px); border-color: var(--pink); }
  .perk-icon { font-size: 2rem; display: block; margin-bottom: 1rem; }
  .perk-card h3 { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600; margin: 0 0 .5rem; }
  .perk-card p { font-family: var(--font-body); font-size: .85rem; line-height: 1.5; color: var(--muted); margin: 0; }

  /* Openings */
  .openings-section { padding: 8rem 10vw; }
  .openings-heading { margin-bottom: 5rem; }
  .jobs-list { display: flex; flex-direction: column; gap: 2rem; }
  .job-card {
    border: 1px solid var(--line); border-radius: 20px;
    padding: 3rem; background: white;
    transition: border-color .3s, box-shadow .3s, transform .3s;
  }
  .job-card:hover { border-color: var(--pink); transform: translateY(-4px); box-shadow: 0 20px 50px rgba(0,0,62,.06); }
  .job-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; }
  .job-tags { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1rem; }
  .job-tags span {
    font-family: var(--font-body); font-size: .65rem;
    letter-spacing: .08em; text-transform: uppercase;
    padding: .35rem .75rem; border-radius: 100px;
  }
  .tag-dept { background: rgba(221,46,184,.08); color: var(--pink); }
  .tag-type { background: rgba(63,154,230,.1); color: var(--blue-bell); }
  .tag-loc { background: rgba(0,0,62,.06); color: var(--ink); }
  .job-title { font-family: var(--font-heading); font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 600; margin: 0; }
  .apply-btn {
    display: inline-flex; align-items: center; gap: .5rem;
    font-family: var(--font-body); font-size: .75rem;
    letter-spacing: .1em; text-transform: uppercase;
    text-decoration: none; color: var(--paper);
    background: var(--ink); padding: .9rem 1.8rem;
    border-radius: 100px; transition: background .3s, transform .2s;
    white-space: nowrap; flex-shrink: 0;
  }
  .apply-btn:hover { background: var(--pink); transform: translateY(-2px); }
  .job-desc { font-family: var(--font-body); font-size: .95rem; line-height: 1.6; color: var(--muted); margin: 1.5rem 0; }
  .job-skills { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; border-top: 1px solid rgba(0,0,62,.08); padding-top: 1.5rem; }
  .skills-label { font-family: var(--font-body); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-right: .5rem; }
  .skill-chip {
    font-family: var(--font-body); font-size: .72rem;
    background: rgba(0,0,62,.04); color: var(--ink);
    padding: .35rem .8rem; border-radius: 6px;
  }

  /* Speculative CTA */
  .speculative-cta { background: var(--ink); color: var(--paper); padding: 8rem 10vw; text-align: center; }
  .speculative-cta .section-label { color: var(--blue-bell); }
  .cta-copy { font-size: 1.15rem; color: rgba(244,247,255,.65); max-width: 550px; margin: 1.5rem auto 3rem; line-height: 1.5; }
  .cta-button {
    display: inline-flex; align-items: center; gap: 1rem;
    font-family: var(--font-body); font-size: .78rem;
    letter-spacing: .12em; text-transform: uppercase;
    text-decoration: none; color: var(--paper);
    border: 1px solid var(--blue-bell); padding: 1.2rem 2.5rem;
    transition: background .3s, border-color .3s;
  }
  .cta-button:hover { background: rgba(63,154,230,.15); border-color: var(--paper); }

  @media (max-width: 960px) {
    .culture-grid { grid-template-columns: 1fr; }
    .perks-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .careers-culture, .openings-section, .speculative-cta { padding: 5rem 20px; }
    .perks-grid { grid-template-columns: 1fr; }
    .job-card { padding: 2rem 1.5rem; }
    .job-header { flex-direction: column; align-items: flex-start; }
    .apply-btn { width: 100%; justify-content: center; margin-top: .5rem; }
  }
</style>
